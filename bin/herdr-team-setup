#!/usr/bin/env bash
# herdr-team-setup — legacy alias of herdr-team (100% backward compatible).
# All logic lives in bin/herdr-team; this wrapper forwards every argument.
# Sibling resolution works both for direct execution and via ~/bin symlinks.
set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
exec "$SELF_DIR/herdr-team" "$@"
