#!/usr/bin/env bash
# herdr-team-setup — Herdr 기반 3인 에이전트 팀 원클릭 셋업 (PM + planner/worker/reviewer)
#
# 사용법:
#   herdr-team-setup [prefix] [options]
#   herdr-team-setup --help
#
# 예:
#   herdr-team-setup               # 현재 폴더(git root 우선) 기반 prefix 자동 결정
#   herdr-team-setup myproj        # prefix=myproj 강제
#   herdr-team-setup sd --dry-run  # 실행 없이 계획만 출력
#
# 동작 개요:
#   1) prefix 결정 ($1 또는 자동 추출)
#   2) AGENTS.md / agents/<prefix>-*.md 없으면 템플릿 복사 또는 기본 문서 생성
#   3) 현재 Pane(PM) 기준 우측 분할(Planner) → 해당 Pane을 아래로 2번 분할(Worker, Reviewer)
#   4) 3개 Pane 높이 균등화(herdr pane resize, best-effort)
#   5) Pane 레이블링 + 에이전트 시작(멱등)
set -euo pipefail

KIND="opencode"
DRY_RUN=0
NO_RESIZE=0
NO_START=0
NO_TEMPLATE=0
FORCE=0
TEMPLATE_DIR="${HERDR_TEAM_TEMPLATE_DIR:-$HOME/templates/agent-team}"
CWD="$PWD"
PREFIX_ARG=""

usage() {
  cat <<'EOF'
Usage: herdr-team-setup [prefix] [options]

  prefix            에이전트 prefix (예: sd, myproj). 생략 시 디렉토리 기반 자동 결정.

Options:
  --kind KIND       agent kind for `herdr agent start` (default: opencode)
  --cwd PATH        작업 디렉토리 (default: $PWD)
  --template-dir D  템플릿 디렉토리 (default: ~/templates/agent-team)
  --no-template     템플릿 복사/생성 단계 생략
  --no-resize       pane resize 단계 생략
  --no-start        에이전트 시작 생략 (분할+레이블만 수행)
  --force           기존 AGENTS.md/agents 문서 덮어쓰기
  --dry-run         실제 실행 없이 수행할 명령만 출력
  -h, --help        이 도움말 출력

Prefix 자동 결정 규칙:
  git root 디렉토리명 우선, 없으면 현재 폴더명 사용 → 소문자·영숫자만 남김.
  4글자 이하면 그대로, 길면 구분자([-_. ]/camelCase/숫자 경계) 앞글자(이니셜, 최대 4자),
  그래도 1글자면 앞 2글자로 축약. (예: try2→try2, my-project→mp, scandimension→sc)
  잘 알려진 축약(sd 등)은 인자로 명시: `herdr-team-setup sd`.

Layout:
  [PM: 현재 Pane] | [Planner (우측 상단)]
                    [Worker  (우측 중단)]
                    [Reviewer(우측 하단)]
  우측 3개 Pane은 resize로 약 1:1:1 균등화 시도(버전별 amount 의미가 달라 best-effort).

Labels:
  ① PM / ② Planner ({prefix}-planner) / ③ Worker ({prefix}-worker) / ④ Reviewer ({prefix}-reviewer)
EOF
}

# --- 인자 파싱 ---
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    --dry-run) DRY_RUN=1; shift ;;
    --no-resize) NO_RESIZE=1; shift ;;
    --no-start) NO_START=1; shift ;;
    --no-template) NO_TEMPLATE=1; shift ;;
    --force) FORCE=1; shift ;;
    --kind) KIND="${2:?--kind에 값이 필요합니다}"; shift 2 ;;
    --cwd) CWD="${2:?--cwd에 값이 필요합니다}"; shift 2 ;;
    --template-dir) TEMPLATE_DIR="${2:?--template-dir에 값이 필요합니다}"; shift 2 ;;
    --*) echo "error: 알 수 없는 옵션: $1 (도움말: --help)" >&2; exit 2 ;;
    *) if [[ -z "$PREFIX_ARG" ]]; then PREFIX_ARG="$1"; else echo "error: prefix는 1개만 지정 가능합니다: $1" >&2; exit 2; fi; shift ;;
  esac
done

# --- prefix 자동 추출 ---
auto_prefix() {
  local base=""
  if git -C "$CWD" rev-parse --show-toplevel >/dev/null 2>&1; then
    base="$(basename "$(git -C "$CWD" rev-parse --show-toplevel)")"
  else
    base="$(basename "$CWD")"
  fi
  # 소문자 + 영숫자만
  local clean
  clean="$(printf '%s' "$base" | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9' ' ')"
  clean="$(printf '%s' "$clean" | tr -s ' ' | sed -e 's/^ *//;s/ *$//')"
  local nospace
  nospace="$(printf '%s' "$clean" | tr -d ' ')"
  if [[ -z "$nospace" ]]; then printf 'tm'; return; fi
  if [[ ${#nospace} -le 4 ]]; then printf '%s' "$nospace"; return; fi
  # camelCase/숫자 경계에 공백 삽입 후 토큰 이니셜
  local spaced="$base"
  spaced="$(printf '%s' "$spaced" | sed -E -e 's/([a-z0-9])([A-Z])/\1 \2/g' -e 's/([A-Za-z])([0-9])/\1 \2/g' -e 's/([0-9])([A-Za-z])/\1 \2/g' -e 's/[-_.]+/ /g')"
  local initials=""
  local w
  for w in $spaced; do
    local ch
    ch="$(printf '%s' "$w" | tr '[:upper:]' '[:lower:]' | cut -c1)"
    case "$ch" in [a-z0-9]) initials+="$ch" ;; esac
    if [[ ${#initials} -ge 4 ]]; then break; fi
  done
  if [[ ${#initials} -ge 2 ]]; then printf '%s' "$initials"; return; fi
  printf '%s' "${nospace:0:2}"
}

PREFIX="${PREFIX_ARG:-$(auto_prefix)}"
# prefix 위생 처리 (에이전트 이름에 안전 문자만)
PREFIX="$(printf '%s' "$PREFIX" | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9-' '-' | sed -e 's/^-*//;s/-*$//')"
if [[ -z "$PREFIX" ]]; then echo "error: 유효한 prefix를 결정할 수 없습니다." >&2; exit 2; fi

PLANNER="${PREFIX}-planner"
WORKER="${PREFIX}-worker"
REVIEWER="${PREFIX}-reviewer"

run() {
  if [[ "$DRY_RUN" -eq 1 ]]; then
    printf '+ %s\n' "$*"
  else
    "$@"
  fi
}
log() { printf '[herdr-team-setup] %s\n' "$*"; }
# herdr JSON 출력에서 pane_id 추출 (jq 기반, 버전별 필드 차이 흡수).
# split/current 응답은 {"result":{"pane":{"pane_id":"wD:p1F",...}}} 형태가 표준이며,
# 구버전/변형 응답(.result.pane_id, .pane_id, bare ID)도 순서대로 시도한다.
herdr_pane_id() {
  jq -r '
    .result.pane.pane_id
    // .result.pane_id
    // .result.id
    // .pane.pane_id
    // .pane_id
    // .id
    // empty
  ' 2>/dev/null | head -n1
}
need_cmd() {
  if ! command -v "$1" >/dev/null 2>&1; then
    echo "error: '$1' 명령을 찾을 수 없습니다." >&2; exit 127
  fi
}

# --- 1) 템플릿 복사/생성 ---
setup_templates() {
  if [[ "$NO_TEMPLATE" -eq 1 ]]; then log "템플릿 단계 생략(--no-template)"; return; fi
  # 이미 팀 문서가 있으면(AGENTS.md + agents/*-planner.md) 생략.
  # 단, 요청 prefix용 파일이 없고 FORCE도 없으면 다른 prefix 문서가 있다는 안내만 하고 생략.
  local existing_planner=""
  existing_planner="$(ls "$CWD/agents/" 2>/dev/null | grep -E '\-planner\.md$' | head -n1 || true)"
  if [[ -f "$CWD/AGENTS.md" && -n "$existing_planner" && "$FORCE" -eq 0 ]]; then
    if [[ -f "$CWD/agents/${PLANNER}.md" ]]; then
      log "AGENTS.md + agents 문서 존재 → 템플릿 단계 생략"
    else
      log "팀 문서 존재(${existing_planner}, prefix 불일치?) → 생성 생략. '${PREFIX}'용 문서가 필요하면 --force 또는 해당 prefix로 재실행"
    fi
    return
  fi

  # 외부 템플릿 디렉토리가 있으면 복사(파일 내 {{PREFIX}} 치환)
  if [[ -d "$TEMPLATE_DIR" ]]; then
    log "외부 템플릿 사용: $TEMPLATE_DIR"
    if [[ "$DRY_RUN" -eq 1 ]]; then
      printf '+ mkdir -p %s/agents && cp %s/* %s/ ({{PREFIX}}→%s 치환)\n' "$CWD" "$TEMPLATE_DIR" "$CWD" "$PREFIX"
      return
    fi
    mkdir -p "$CWD/agents"
    if [[ -f "$TEMPLATE_DIR/AGENTS.md" && ( ! -f "$CWD/AGENTS.md" || "$FORCE" -eq 1 ) ]]; then
      sed "s/{{PREFIX}}/${PREFIX}/g" "$TEMPLATE_DIR/AGENTS.md" > "$CWD/AGENTS.md"
    fi
    for role in planner worker reviewer; do
      local src="$TEMPLATE_DIR/agents/ROLE-${role}.md"
      local dst="$CWD/agents/${PREFIX}-${role}.md"
      if [[ ! -f "$src" ]]; then src="$TEMPLATE_DIR/${PREFIX}-${role}.md"; fi
      if [[ -f "$src" && ( ! -f "$dst" || "$FORCE" -eq 1 ) ]]; then
        sed "s/{{PREFIX}}/${PREFIX}/g" "$src" > "$dst"
      fi
    done
    return
  fi

  # 내장 기본 문서 생성 ({{PREFIX}} 치환 완료 상태)
  log "내장 템플릿으로 기본 문서 생성 (prefix=${PREFIX})"
  if [[ "$DRY_RUN" -eq 1 ]]; then
    printf '+ (내장 템플릿) %s/AGENTS.md + agents/%s-{planner,worker,reviewer}.md 생성\n' "$CWD" "$PREFIX"
    return
  fi
  mkdir -p "$CWD/agents"
  if [[ ! -f "$CWD/AGENTS.md" || "$FORCE" -eq 1 ]]; then
    cat > "$CWD/AGENTS.md" <<EOF
# Agents Configuration & Team Orchestration

3인 체제(PM - ${PLANNER} - ${WORKER} - ${REVIEWER}) + On-Demand 에이전트 정의서입니다.

## 1. 소통 흐름 (Communication Flow) — 순차 DAG (3인 체제)

\`\`\`
[ User ] → [ PM (agy) ] → [ ${PLANNER} ] → [ ${WORKER} ] → [ ${REVIEWER} ] ─ [APPROVE + 실행 로그] → 보고
                                                    ↑________ [REQUEST CHANGES] ________|
\`\`\`

- Team 간 직접 협업 금지. 모든 반송/승인은 PM 경유.
- 수정 권한: 코드를 직접 수정하는 것은 \`${WORKER}\`뿐. \`${REVIEWER}\`는 수정 없이 보고서만.

### 1.1 PM 가드레일
- ❌ 금지: 파일 편집, 테스트/빌드 실행, git commit/push, pane 직접 코딩.
- ✅ 허용: \`herdr agent list/read\`, \`herdr pane list/read\`, \`git status/diff/log\` 취합 보고.
- 위임 고정: 기획→\`${PLANNER}\`, 구현→\`${WORKER}\`, 실행 검증 겸 리뷰→\`${REVIEWER}\`.

## 2. 에이전트 역할
| 에이전트 | 역할 | 문서 |
|---|---|---|
| PM | 총괄 (agy) | 본 문서 |
| ${PLANNER} | 기획/설계 + Task Breakdown | agents/${PLANNER}.md |
| ${WORKER} | TDD 구현 + 단위 테스트 PASS | agents/${WORKER}.md |
| ${REVIEWER} | 실행 검증 겸 리뷰, [APPROVE]/[REQUEST CHANGES] | agents/${REVIEWER}.md |

## 3. Herdr 운용
- 고정 Pane ID 금지. \`herdr pane/tab/agent list\`로 조회.
- \`herdr-team-setup ${PREFIX}\` 실행 시 현재 Pane(PM) 기준 우측 분할 후 아래로 2분할, resize 균등화.
EOF
  fi
  for role in planner worker reviewer; do
    local dst="$CWD/agents/${PREFIX}-${role}.md"
    if [[ -f "$dst" && "$FORCE" -eq 0 ]]; then continue; fi
    case "$role" in
      planner) cat > "$dst" <<EOF
# Role: ${PLANNER} (기획 및 아키텍처 설계)

## 핵심 미션
요구사항 분석, 아키텍처/데이터 흐름 설계, \`${WORKER}\`가 즉시 구현 가능한 Task Breakdown 작성.

## 산출물
- 요구사항 요약 & 목표 / 아키텍처 & 데이터 흐름 / 작업 분할(완료 기준·TDD 대상) / 엣지 케이스.
- 직접 코드 구현 금지 (인터페이스 예시만 가능).
EOF
        ;;
      worker) cat > "$dst" <<EOF
# Role: ${WORKER} (개발 및 단위 테스트 구현)

## 핵심 미션
TDD Red→Green→Refactor로 구현하고 단위 테스트를 통과시킴.

## 보고 형식
- 작업 개요 / 변경·추가 파일 / 단위 테스트 결과 / 특이사항 & 다음 제안.
- 주요 이론 내용은 \`til/\`에 기록 후 커밋.
EOF
        ;;
      reviewer) cat > "$dst" <<EOF
# Role: ${REVIEWER} (실행 검증 겸 코드 리뷰, 최종 게이트)

## 핵심 미션
정적 리뷰 + 빌드/단위/통합·E2E·회귀 직접 실행 후 [APPROVE]/[REQUEST CHANGES] 판정.
[APPROVE]는 실행 커맨드·로그 첨부 시에만 유효. 코드 수정 금지.
EOF
        ;;
    esac
  done
}

# --- 2) Pane 분할 + 리사이즈 + 레이블 + 에이전트 시작 ---
setup_panes() {
  need_cmd herdr
  need_cmd jq
  local base_pane=""
  base_pane="$(herdr pane current 2>/dev/null | herdr_pane_id || true)"
  if [[ -z "$base_pane" ]]; then
    # current 파싱 실패 시 HERDR_PANE_ID env로 fallback
    base_pane="${HERDR_PANE_ID:-}"
  fi
  if [[ "$DRY_RUN" -eq 1 ]]; then
    log "prefix=${PREFIX} kind=${KIND} cwd=${CWD} (dry-run)"
    printf '+ BASE=$(herdr pane current | jq -r .result.pane.pane_id)  # PM pane\n'
    printf '+ P_PLANNER=$(herdr pane split "$BASE" --direction right --cwd "%s" --no-focus | jq -r .result.pane.pane_id)\n' "$CWD"
    printf '+ P_WORKER=$(herdr pane split "$P_PLANNER" --direction down --cwd "%s" --no-focus | jq -r .result.pane.pane_id)\n' "$CWD"
    printf '+ P_REVIEWER=$(herdr pane split "$P_WORKER" --direction down --cwd "%s" --no-focus | jq -r .result.pane.pane_id)\n' "$CWD"
    if [[ "$NO_RESIZE" -eq 0 ]]; then
      printf '+ herdr pane resize --pane "$P_WORKER" --direction up --amount 0.10   # 균등화 best-effort\n'
      printf '+ herdr pane resize --pane "$P_REVIEWER" --direction down --amount 0.10 # 균등화 best-effort\n'
    fi
    printf '+ herdr pane rename "$BASE" "① PM"\n'
    printf '+ herdr pane rename "$P_PLANNER" "② Planner (%s)"\n' "$PLANNER"
    printf '+ herdr pane rename "$P_WORKER" "③ Worker (%s)"\n' "$WORKER"
    printf '+ herdr pane rename "$P_REVIEWER" "④ Reviewer (%s)"\n' "$REVIEWER"
    if [[ "$NO_START" -eq 0 ]]; then
      printf '+ herdr agent list | grep -q %s || herdr agent start %s --kind %s --pane "$P_PLANNER"\n' "$PLANNER" "$PLANNER" "$KIND"
      printf '+ herdr agent list | grep -q %s || herdr agent start %s --kind %s --pane "$P_WORKER"\n' "$WORKER" "$WORKER" "$KIND"
      printf '+ herdr agent list | grep -q %s || herdr agent start %s --kind %s --pane "$P_REVIEWER"\n' "$REVIEWER" "$REVIEWER" "$KIND"
    fi
    return
  fi

  if [[ -z "$base_pane" ]]; then
    echo "error: 현재 Pane ID를 확인할 수 없습니다. Herdr 세션 안에서 실행하세요." >&2
    exit 1
  fi
  log "BASE(PM) pane: $base_pane"
  local p_planner p_worker p_reviewer
  local split_out=""
  split_out="$(herdr pane split "$base_pane" --direction right --cwd "$CWD" --no-focus)"
  p_planner="$(printf '%s' "$split_out" | herdr_pane_id || true)"
  if [[ -z "$p_planner" ]]; then echo "error: Planner 분할 결과에서 pane_id 파싱 실패: $split_out" >&2; exit 1; fi
  log "Planner pane: $p_planner"
  split_out="$(herdr pane split "$p_planner" --direction down --cwd "$CWD" --no-focus)"
  p_worker="$(printf '%s' "$split_out" | herdr_pane_id || true)"
  if [[ -z "$p_worker" ]]; then echo "error: Worker 분할 결과에서 pane_id 파싱 실패: $split_out" >&2; exit 1; fi
  log "Worker pane: $p_worker"
  split_out="$(herdr pane split "$p_worker" --direction down --cwd "$CWD" --no-focus)"
  p_reviewer="$(printf '%s' "$split_out" | herdr_pane_id || true)"
  if [[ -z "$p_reviewer" ]]; then echo "error: Reviewer 분할 결과에서 pane_id 파싱 실패: $split_out" >&2; exit 1; fi
  log "Reviewer pane: $p_reviewer"

  if [[ "$NO_RESIZE" -eq 0 ]]; then
    # 우측 컬럼 3분할 균등화 시도. amount 의미가 버전별로 다를 수 있어 실패 무시(best-effort).
    herdr pane resize --pane "$p_worker" --direction up --amount 0.10 || true
    herdr pane resize --pane "$p_reviewer" --direction down --amount 0.10 || true
    log "resize 균등화 시도 완료 (best-effort, 육안 확인 권장)"
  fi

  run herdr pane rename "$base_pane" "① PM"
  run herdr pane rename "$p_planner" "② Planner (${PLANNER})"
  run herdr pane rename "$p_worker" "③ Worker (${WORKER})"
  run herdr pane rename "$p_reviewer" "④ Reviewer (${REVIEWER})"

  if [[ "$NO_START" -eq 0 ]]; then
    if ! herdr agent list 2>/dev/null | grep -q -- "$PLANNER"; then
      run herdr agent start "$PLANNER" --kind "$KIND" --pane "$p_planner"
    else log "$PLANNER 이미 존재 → 시작 생략"; fi
    if ! herdr agent list 2>/dev/null | grep -q -- "$WORKER"; then
      run herdr agent start "$WORKER" --kind "$KIND" --pane "$p_worker"
    else log "$WORKER 이미 존재 → 시작 생략"; fi
    if ! herdr agent list 2>/dev/null | grep -q -- "$REVIEWER"; then
      run herdr agent start "$REVIEWER" --kind "$KIND" --pane "$p_reviewer"
    else log "$REVIEWER 이미 존재 → 시작 생략"; fi
  fi
  log "완료: prefix=${PREFIX} (${PLANNER} / ${WORKER} / ${REVIEWER})"
}

setup_templates
setup_panes
