#!/usr/bin/env bash
# herdr-team — Herdr 기반 에이전트 팀 원클릭 셋업 (PM + orchestrator + planner/worker/reviewer)
#
# 사용법:
#   herdr-team [prefix] [options]
#   herdr-team --help
#
# 예:
#   herdr-team               # 현재 폴더(git root 우선) 기반 prefix 자동 결정
#   herdr-team myproj        # prefix=myproj 강제
#   herdr-team sd --dry-run  # 실행 없이 계획만 출력
#
# 동작 개요:
#   1) prefix 결정 ($1 또는 자동 추출)
#   2) AGENTS.md / agents/<prefix>-*.md 없으면 템플릿 복사 또는 기본 문서 생성
#   3) 현재 Pane(PM) 기준 우측 분할(Orchestrator) → 해당 Pane을 아래로 순차 분할(Planner, Worker, ...)
#   4) 우측 컬럼 down 분할 시 --ratio 1/(N-k+1)로 정확 균등화 (1:1:1:1, resize 불필요)
#   5) Pane 레이블링 + 에이전트 시작(멱등)
set -euo pipefail

KIND_ARG=""
KIND=""
DRY_RUN=0
TEMPLATES_ONLY=0
NO_RESIZE=0
NO_START=0
NO_TEMPLATE=0
NO_INTERACTIVE=0
LIST_PRESETS=0
FORCE=0
NO_GITIGNORE=0
NO_BACKUP=0
WATCHER=0
NO_AUTO_ALLOW=0
PRESET_ARG=""
PRESET=""
TEMPLATE_DIR="${HERDR_TEAM_TEMPLATE_DIR:-$HOME/templates/agent-team}"
CWD="$PWD"
PREFIX_ARG=""

# Herdr 지원 에이전트 종류 목록
SUPPORTED_KINDS="opencode claude codex agy pi gemini cursor devin cline omp mastracode copilot kimi kiro droid amp grok hermes kilo qodercli maki"

# --- preset 동적 열거 (하드코딩 대신 templates/<name>/preset.conf 발견) ---
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
# --- 버전 단일 정본 (VERSION) ---
# 심볼릭 실행(~/bin/herdr-team -> repo/bin/herdr-team) 시 BASH_SOURCE[0] 는 심볼릭
# 경로이므로 실제 스크립트 경로를 해석한다. readlink -f 미지원(BSD/macOS) 시
# realpath → python3 realpath 순서로 폴백하고, 모두 실패하면 원 경로를 쓴다.
# VERSION 경로는 <real script dir>/../VERSION.
version_file() {
  local src="${BASH_SOURCE[0]:-$0}" real=""
  real="$(readlink -f "$src" 2>/dev/null || true)"
  if [[ -z "$real" ]]; then real="$(realpath "$src" 2>/dev/null || true)"; fi
  if [[ -z "$real" ]]; then
    real="$(python3 -c 'import os,sys;print(os.path.realpath(sys.argv[1]))' "$src" 2>/dev/null || true)"
  fi
  [[ -n "$real" ]] || real="$src"
  printf '%s/../VERSION' "$(cd "$(dirname "$real")" && pwd)"
}
read_version() {
  local f v
  f="$(version_file)"
  if [[ -f "$f" ]]; then
    v="$(head -n1 "$f" | tr -d '[:space:]')"
    if [[ -n "$v" ]]; then printf '%s' "$v"; return 0; fi
  fi
  printf 'unknown'
}
VERSION="$(read_version)"

# --- i18n: 로케일 결정 + 문자열 카탈로그 (명세 §3) ---
# 결정 순서: HERDR_TEAM_LANG > LC_ALL > LANG > en. 시작 시 1회 확정(실행 중 불변).
# 카탈로그는 스크립트 내부 함수(단일 파일 배포 무결성 — 명세 §3.2 A안).
MSG_LOCALE=""
MSG_KEYS="parse.opt.missing.kind parse.opt.missing.layout parse.opt.missing.cwd parse.opt.missing.template_dir parse.opt.missing.preset parse.opt.unknown parse.prefix.multiple parse.prefix.invalid layout.unknown precheck.warn.skip precheck.err.title precheck.install.cmd precheck.verify precheck.bypass preset.usage.none preset.list.noconf preset.menu.title preset.menu.prompt preset.warn.deprecated preset.err.unknown.name preset.err.unknown.number preset.err.cli.unknown preset.err.conf.missing preset.err.conf.missing.found kind.menu.title kind.menu.item1 kind.menu.prompt kind.err.unknown kind.err.unknown.cli"
ht_detect_locale() {
  local v="${HERDR_TEAM_LANG:-}"
  if [[ -n "$v" ]]; then
    case "$v" in en|ko) printf '%s' "$v"; return 0 ;; *) printf 'en'; return 1 ;; esac
  fi
  if [[ -n "${LC_ALL:-}" ]]; then
    case "$LC_ALL" in ko*) printf 'ko'; return 0 ;; *) printf 'en'; return 0 ;; esac
  fi
  if [[ -n "${LANG:-}" ]]; then
    case "$LANG" in ko*) printf 'ko'; return 0 ;; *) printf 'en'; return 0 ;; esac
  fi
  printf 'en'
}
if ! MSG_LOCALE="$(ht_detect_locale)"; then
  printf 'WARN: unknown HERDR_TEAM_LANG=%s → falling back to en\n' "${HERDR_TEAM_LANG:-}" >&2
fi
msg() { # msg KEY [ARGS...] — 개행 포함 여부는 키 서식에 고정
  local key="$1"; shift
  if [[ "$MSG_LOCALE" == "ko" ]]; then _msg_ko "$key" "$@"; else _msg_en "$key" "$@"; fi
}
_msg_en() {
  case "$1" in
    parse.opt.missing.kind) printf 'error: --kind requires a value\n' ;;
    parse.opt.missing.layout) printf 'error: --layout requires a value (2col|right-stack)\n' ;;
    parse.opt.missing.cwd) printf 'error: --cwd requires a value\n' ;;
    parse.opt.missing.template_dir) printf 'error: --template-dir requires a value\n' ;;
    parse.opt.missing.preset) printf 'error: --preset requires a value (list: --list-presets)\n' ;;
    parse.opt.unknown) printf 'error: unknown option: %s (--help)\n' "$2" ;;
    parse.prefix.multiple) printf 'error: prefix must be given once: %s\n' "$2" ;;
    parse.prefix.invalid) printf 'error: cannot determine a valid prefix\n' ;;
    layout.unknown) printf 'error: unknown layout: %s (choose 2col or right-stack)\n' "$2" ;;
    precheck.warn.skip) printf 'WARN: herdr CLI not found, continuing anyway (HERDR_TEAM_SKIP_CHECK=1)\n' ;;
    precheck.err.title) printf 'ERROR herdr CLI not found — herdr-team runs on top of herdr.\n' ;;
    precheck.install.cmd) printf '  Install:\n    curl -fsSL https://herdr.dev/install.sh | sh\n    Windows: powershell -ExecutionPolicy Bypass -c "irm https://herdr.dev/install.ps1 | iex"\n' ;;
    precheck.verify) printf '  Verify:  herdr --version\n' ;;
    precheck.bypass) printf '  Bypass:  HERDR_TEAM_SKIP_CHECK=1\n' ;;
    preset.usage.none) printf '(none)' ;;
    preset.list.noconf) printf '(preset.conf missing)' ;;
    preset.menu.title) printf 'Select AI team preset (1-%s or name, default: %s):\n' "$2" "$3" ;;
    preset.menu.prompt) printf 'Select [1-%s/%s] (default: %s, 10s): ' "$2" "$3" "$4" ;;
    preset.warn.deprecated) printf "[herdr-team] WARN: preset '%s' is deprecated; use '%s' instead. (app merged into dev)\n" "$2" "$3" ;;
    preset.err.unknown.name) printf 'error: unknown preset choice: %s (available: %s)\n' "$2" "$3" ;;
    preset.err.unknown.number) printf 'error: unknown preset choice: %s (1-%s or name)\n' "$2" "$3" ;;
    preset.err.cli.unknown) printf 'error: unknown preset: %s (available: %s. list: --list-presets)\n' "$2" "$3" ;;
    preset.err.conf.missing) printf "error: preset.conf for '%s' not found. templates/<preset>/preset.conf is required (search: %s, %s).\n" "$2" "$3" "$4" ;;
    preset.err.conf.missing.found) printf "error: preset.conf for '%s' not found (discovered: %s; search: %s, %s).\n" "$2" "$3" "$4" "$5" ;;
    kind.menu.title) printf 'Select agent kind (1-4 or name, default: opencode):\n' ;;
    kind.menu.item1) printf '  1) opencode - OpenCode Interpreter\n' ;;
    kind.menu.prompt) printf 'Select [1-4/opencode/claude/codex/agy] (default: opencode, 10s): ' ;;
    kind.err.unknown) printf 'error: unknown agent kind choice: %s\n' "$2" ;;
    kind.err.unknown.cli) printf 'error: unknown agent kind: %s (supported: opencode, claude, codex, agy, pi, gemini, cursor, ...)\n' "$2" ;;
  esac
}
_msg_ko() {
  case "$1" in
    parse.opt.missing.kind) printf 'error: --kind에 값이 필요합니다\n' ;;
    parse.opt.missing.layout) printf 'error: --layout에 값이 필요합니다 (2col|right-stack)\n' ;;
    parse.opt.missing.cwd) printf 'error: --cwd에 값이 필요합니다\n' ;;
    parse.opt.missing.template_dir) printf 'error: --template-dir에 값이 필요합니다\n' ;;
    parse.opt.missing.preset) printf 'error: --preset에 값이 필요합니다 (목록: --list-presets)\n' ;;
    parse.opt.unknown) printf 'error: 알 수 없는 옵션: %s (도움말: --help)\n' "$2" ;;
    parse.prefix.multiple) printf 'error: prefix는 1개만 지정 가능합니다: %s\n' "$2" ;;
    parse.prefix.invalid) printf 'error: 유효한 prefix를 결정할 수 없습니다.\n' ;;
    layout.unknown) printf 'error: 알 수 없는 layout: %s (2col|right-stack 중 선택)\n' "$2" ;;
    precheck.warn.skip) printf 'WARN: herdr CLI 를 찾을 수 없지만 HERDR_TEAM_SKIP_CHECK=1 로 계속 진행합니다.\n' ;;
    precheck.err.title) printf 'ERROR herdr CLI 를 찾을 수 없습니다.\n' ;;
    precheck.install.cmd) printf '  설치:\n    curl -fsSL https://herdr.dev/install.sh | sh\n    Windows: powershell -ExecutionPolicy Bypass -c "irm https://herdr.dev/install.ps1 | iex"\n' ;;
    precheck.verify) printf '  확인:  herdr --version\n' ;;
    precheck.bypass) printf '  우회:  HERDR_TEAM_SKIP_CHECK=1\n' ;;
    preset.usage.none) printf '(없음)' ;;
    preset.list.noconf) printf '(preset.conf 없음)' ;;
    preset.menu.title) printf 'AI 팀 프리셋을 선택하세요 (1-%s 또는 이름, 기본: %s):\n' "$2" "$3" ;;
    preset.menu.prompt) printf 'Select [1-%s/%s] (default: %s, 10s): ' "$2" "$3" "$4" ;;
    preset.warn.deprecated) printf "[herdr-team] 경고: preset '%s'는 deprecated입니다. '%s'로 대체합니다. (app은 dev에 통합되었습니다)\n" "$2" "$3" ;;
    preset.err.unknown.name) printf 'error: 알 수 없는 preset 선택: %s (사용 가능: %s)\n' "$2" "$3" ;;
    preset.err.unknown.number) printf 'error: 알 수 없는 preset 선택: %s (1-%s 또는 이름)\n' "$2" "$3" ;;
    preset.err.cli.unknown) printf 'error: 알 수 없는 preset: %s (사용 가능: %s. 목록: --list-presets)\n' "$2" "$3" ;;
    preset.err.conf.missing) printf "error: preset '%s'의 preset.conf를 찾을 수 없습니다. templates/<preset>/preset.conf가 필요합니다 (탐색 경로: %s, %s).\n" "$2" "$3" "$4" ;;
    preset.err.conf.missing.found) printf "error: preset '%s'의 preset.conf를 찾을 수 없습니다 (발견된 preset: %s; 탐색 경로: %s, %s).\n" "$2" "$3" "$4" "$5" ;;
    kind.menu.title) printf '에이전트 종류를 선택하세요 (1-4 또는 이름, 기본: opencode):\n' ;;
    kind.menu.item1) printf '  1) opencode - OpenCode Interpreter (기본값)\n' ;;
    kind.menu.prompt) printf 'Select [1-4/opencode/claude/codex/agy] (default: opencode, 10s): ' ;;
    kind.err.unknown) printf 'error: 알 수 없는 agent kind 선택: %s\n' "$2" ;;
    kind.err.unknown.cli) printf 'error: 알 수 없는 agent kind: %s (지원 목록: opencode, claude, codex, agy, pi, gemini, cursor 등)\n' "$2" ;;
  esac
}

# 기본 노출 순서/기본값 안정용 힌트. 여기 없는 preset도 자동 발견되어 뒤에 추가된다.
PRESET_ORDER="dev research biz mkt creator"
# preset 디렉토리 탐색: --template-dir/<preset> 우선, 없으면 스크립트 번들 templates/<preset>
preset_dir() {
  local name="$1"
  if [[ -f "$TEMPLATE_DIR/$name/preset.conf" ]]; then printf '%s' "$TEMPLATE_DIR/$name"; return 0; fi
  if [[ -f "$SCRIPT_DIR/../templates/$name/preset.conf" ]]; then printf '%s' "$SCRIPT_DIR/../templates/$name"; return 0; fi
  return 1
}
preset_desc() {
  local name="$1" dir=""
  dir="$(preset_dir "$name" 2>/dev/null || true)"
  if [[ -n "$dir" ]]; then
    grep -E '^PRESET_DESC=' "$dir/preset.conf" 2>/dev/null | sed -e 's/^PRESET_DESC=//' -e 's/^"//' -e 's/"$//' | head -n1
  fi
}
discover_presets() {
  local root dir name seen=""
  for root in "$TEMPLATE_DIR" "$SCRIPT_DIR/../templates"; do
    [[ -d "$root" ]] || continue
    for dir in "$root"/*/; do
      [[ -d "$dir" ]] || continue
      name="$(basename "$dir")"
      [[ -f "$dir/preset.conf" ]] || continue
      case " $seen " in *" $name "*) continue ;; esac
      seen="$seen $name"; printf '%s\n' "$name"
    done
  done
}
is_discovered() { [[ -n "$(preset_dir "$1" 2>/dev/null || true)" ]]; }
ordered_presets() {
  local n
  for n in $PRESET_ORDER; do
    is_alias "$n" && continue
    is_discovered "$n" && printf '%s\n' "$n"
  done
  for n in $(discover_presets); do
    is_alias "$n" && continue
    case " $PRESET_ORDER " in *" $n "*) ;; *) printf '%s\n' "$n" ;; esac
  done
}
alias_target() { case "$1" in app) printf 'dev' ;; *) printf '%s' "$1" ;; esac; }
is_alias() { case "$1" in app) return 0 ;; *) return 1 ;; esac; }
is_known_preset() { is_discovered "$1" || is_alias "$1"; }
print_preset_usage() {
  local name
  printf 'Presets (templates/<preset>/preset.conf):\n'
  for name in $(ordered_presets); do
    printf '  %-8s %s\n' "$name" "$(preset_desc "$name")"
  done
  printf '  %-8s %s\n' "app" "alias of 'dev' (deprecated; kept for backward compatibility)"
}
preset_usage_list() {
  local list
  list="$(ordered_presets | tr '\n' ' ' | sed -e 's/ *$//')"
  if [[ -n "$list" ]]; then printf '%s' "$list"; else msg preset.usage.none; fi
}

# --- herdr 사전 점검 (herdr-team는 herdr 위에서 동작) ---
# --precheck 및 정상 실행 자동 점검이 공용으로 사용. 있으면 0, 없으면 127,
# HERDR_TEAM_SKIP_CHECK=1 이면 WARN 후 0(우회).
precheck_herdr() {
  if command -v herdr >/dev/null 2>&1; then return 0; fi
  if [[ "${HERDR_TEAM_SKIP_CHECK:-}" == "1" ]]; then
    msg precheck.warn.skip >&2
    return 0
  fi
  {
    msg precheck.err.title
    msg precheck.install.cmd
    msg precheck.verify
    msg precheck.bypass
  } >&2
  return 127
}

usage() {
  printf 'herdr-team v%s\n\n' "$VERSION"
  cat <<'EOF'
Usage: herdr-team [prefix] [options]

  prefix            Agent prefix (e.g. sd, myproj). Auto-detected from the
                    directory name when omitted.

Options:
  --kind KIND       agent kind for `herdr agent start` (default: opencode / TUI menu)
                    (supported: opencode, claude, codex, agy, pi, gemini, cursor, etc.
                     or HERDR_TEAM_KIND)
  --cwd PATH        working directory (default: $PWD)
  --template-dir D  template directory (default: ~/templates/agent-team,
                    or HERDR_TEAM_TEMPLATE_DIR)
  --preset NAME     team preset (see Presets below; or HERDR_TEAM_PRESET;
                    default: dev / TUI menu)
  --layout LAYOUT   team pane layout: 2col | right-stack
                    (or HERDR_TEAM_LAYOUT; default: 2col)
  --list-presets    print available presets and exit
  --precheck        check herdr CLI presence and exit
                    (0 present / 127 missing; HERDR_TEAM_SKIP_CHECK=1 bypasses)
  --no-interactive  never prompt; proceed with defaults (preset=dev, kind=opencode)
  --no-template     skip template copy/generate step
  --no-resize       split without --ratio equalization (no separate resize
                    step; flag kept for compatibility)
  --no-start        skip agent start (split + label only)
  --templates-only  install templates/agents only (skip pane split)
  --force           reseed only the requested preset folder from templates
                    (agents/<preset>/) and force-activate root AGENTS.md;
                    other presets are left untouched
  --watcher         start herdr-watcher in the background (opt-in auto-approve;
                    L2 asks are approved too. stop: kill $(cat .herdr-team/watcher.pid))
                    add --no-auto-allow to monitor only
  --no-gitignore    do not register .herdr-team/ and .opencode/ in .gitignore
  --no-backup       do not back up root AGENTS.md before merging
  --dry-run         print planned commands without executing
  -v, --version     print version and exit
  -h, --help        print this help

  Legacy alias: herdr-team-setup (deprecated, fully compatible —
                forwards every argument to herdr-team).

EOF
  print_preset_usage
  cat <<'EOF'

  With no preset: the TUI menu prompts when stdin allows a choice,
  otherwise preset=dev (--no-interactive, EOF input, or timeout).
  Korean guide: README.ko.md

Prefix auto-detect rules:
  git root directory name first, else current folder name → lowercase alphanumerics.
  Kept as-is when ≤4 chars, else initials of separators ([-_. ]/camelCase/digit
  boundaries, up to 4 chars); single char falls back to first 2 chars.
  (e.g. try2→try2, my-project→mp, scandimension→sc)
  Well-known abbreviations (e.g. sd) should be passed explicitly: `herdr-team sd`.

Layouts:
  2col (default):
    Left column:  [PM: top (50%)] / [Orchestrator: bottom (50%)]
    Right column: [Role 2 (top)] / [Role 3 (middle)] / [Role 4 (bottom)]
    Right-column down splits use --ratio 1/(N-k+1) for exact equalization.
  right-stack:
    Left:         [PM: current pane]
    Right:        [Orchestrator (top)] / [Role 2] / [Role 3] / [Role 4]
    Right-column down splits use --ratio 1/(N-k+1) for exact 1:1:1:1 equalization.

Labels:
  ① PM / ② <role 1 (orchestrator)> / ③ <role 2> / ④ <role 3> / ⑤ <role 4>
  (agents: {prefix}-<role>)
EOF
}

# --- 인자 파싱 ---
LAYOUT_ARG=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    -v|--version) printf 'herdr-team v%s\n' "$VERSION"; exit 0 ;;
    --dry-run) DRY_RUN=1; shift ;;
    --no-resize) NO_RESIZE=1; shift ;;
    --no-start) NO_START=1; shift ;;
    --templates-only) TEMPLATES_ONLY=1; shift ;;
    --no-template) NO_TEMPLATE=1; shift ;;
    --force) FORCE=1; shift ;;
    --no-gitignore) NO_GITIGNORE=1; shift ;;
    --no-backup) NO_BACKUP=1; shift ;;
    --watcher) WATCHER=1; shift ;;
    --no-auto-allow) NO_AUTO_ALLOW=1; shift ;;
    --kind) if [[ -z "${2:-}" ]]; then msg parse.opt.missing.kind >&2; exit 2; fi; KIND_ARG="$2"; shift 2 ;;
    --layout) if [[ -z "${2:-}" ]]; then msg parse.opt.missing.layout >&2; exit 2; fi; LAYOUT_ARG="$2"; shift 2 ;;
    --cwd) if [[ -z "${2:-}" ]]; then msg parse.opt.missing.cwd >&2; exit 2; fi; CWD="$2"; shift 2 ;;
    --template-dir) if [[ -z "${2:-}" ]]; then msg parse.opt.missing.template_dir >&2; exit 2; fi; TEMPLATE_DIR="$2"; shift 2 ;;
    --preset) if [[ -z "${2:-}" ]]; then msg parse.opt.missing.preset >&2; exit 2; fi; PRESET_ARG="$2"; shift 2 ;;
    --list-presets) LIST_PRESETS=1; shift ;;
    --precheck) if precheck_herdr; then exit 0; else exit 127; fi ;;
    --no-interactive) NO_INTERACTIVE=1; shift ;;
    --*) msg parse.opt.unknown "$1" >&2; exit 2 ;;
    *) if [[ -z "$PREFIX_ARG" ]]; then PREFIX_ARG="$1"; else msg parse.prefix.multiple "$1" >&2; exit 2; fi; shift ;;
  esac
done

# --- prefix 자동 추출 ---
auto_prefix() {
  local base=""
  if git -C "$CWD" rev-parse --show-toplevel >/dev/null 2>&1; then
    base="$(basename "$(git -C "$CWD" rev-parse --show-toplevel)")"
  else
    base="$(basename "$CWD")"
  fi
  # 소문자 + 영숫자만
  local clean
  clean="$(printf '%s' "$base" | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9' ' ')"
  clean="$(printf '%s' "$clean" | tr -s ' ' | sed -e 's/^ *//;s/ *$//')"
  local nospace
  nospace="$(printf '%s' "$clean" | tr -d ' ')"
  if [[ -z "$nospace" ]]; then printf 'tm'; return; fi
  if [[ ${#nospace} -le 4 ]]; then printf '%s' "$nospace"; return; fi
  # camelCase/숫자 경계에 공백 삽입 후 토큰 이니셜
  local spaced="$base"
  spaced="$(printf '%s' "$spaced" | sed -E -e 's/([a-z0-9])([A-Z])/\1 \2/g' -e 's/([A-Za-z])([0-9])/\1 \2/g' -e 's/([0-9])([A-Za-z])/\1 \2/g' -e 's/[-_.]+/ /g')"
  local initials=""
  local w
  for w in $spaced; do
    local ch
    ch="$(printf '%s' "$w" | tr '[:upper:]' '[:lower:]' | cut -c1)"
    case "$ch" in [a-z0-9]) initials+="$ch" ;; esac
    if [[ ${#initials} -ge 4 ]]; then break; fi
  done
  if [[ ${#initials} -ge 2 ]]; then printf '%s' "$initials"; return; fi
  printf '%s' "${nospace:0:2}"
}

PREFIX="${PREFIX_ARG:-$(auto_prefix)}"
# prefix 위생 처리 (에이전트 이름에 안전 문자만)
PREFIX="$(printf '%s' "$PREFIX" | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9-' '-' | sed -e 's/^-*//;s/-*$//')"
if [[ -z "$PREFIX" ]]; then msg parse.prefix.invalid >&2; exit 2; fi

# --- preset 해결 (TUI 인터랙티브 메뉴 + 프리셋 지원) ---
# 헬퍼(discover_presets/ordered_presets/alias_target/preset_dir/preset_desc)는
# --help 시점에도 쓸 수 있도록 파일 상단에 정의되어 있다.
list_presets() {
  local name
  for name in $(ordered_presets); do
    local dir="" desc=""
    dir="$(preset_dir "$name" 2>/dev/null || true)"
    desc="$(preset_desc "$name")"
    if [[ -n "$dir" ]]; then
      printf '%-8s %s\n' "$name" "${desc:-$dir}"
    else
      printf '%-8s %s\n' "$name" "$(msg preset.list.noconf)"
    fi
  done
}
choose_preset_tui() {
  # Interactive TUI preset menu (English primary + Korean), dinamically built
  # from discovered presets. Renders to stderr and reads one line from stdin.
  # Falls back to the first ordered preset (dev) on EOF/timeout so it never hangs.
  local names=() n i=1 joined=""
  while IFS= read -r n; do [[ -n "$n" ]] && names+=("$n"); done < <(ordered_presets)
  [[ ${#names[@]} -eq 0 ]] && names=(dev)
  local default="${names[0]}"
  {
    msg preset.menu.title "${#names[@]}" "$default"
    for n in "${names[@]}"; do
      printf '  %d) %s - %s\n' "$i" "$n" "$(preset_desc "$n")"
      joined+="$n/"; i=$((i+1))
    done
    joined="${joined%/}"
    msg preset.menu.prompt "${#names[@]}" "$joined" "$default"
  } >&2
  local ans=""
  if IFS= read -r -t 10 ans <&0 2>/dev/null; then
    ans="$(printf '%s' "$ans" | tr '[:upper:]' '[:lower:]' | tr -d '[:space:]')"
    if [[ -z "$ans" ]]; then printf '%s' "$default"; return; fi
    case "$ans" in
      *[!0-9]*)
        if is_known_preset "$ans"; then
          local canon; canon="$(alias_target "$ans")"
          if [[ "$canon" != "$ans" ]]; then
            msg preset.warn.deprecated "$ans" "$canon" >&2
          fi
          printf '%s' "$canon"
        else
          msg preset.err.unknown.name "$ans" "$(preset_usage_list)" >&2; exit 2
        fi
        ;;
      *)
        if [[ "$ans" -ge 1 && "$ans" -le "${#names[@]}" ]]; then
          printf '%s' "${names[$((ans-1))]}"
        else
          msg preset.err.unknown.number "$ans" "${#names[@]}" >&2; exit 2
        fi
        ;;
    esac
  else
    printf '%s' "$default"
  fi
}

is_known_kind() {
  local k="$1" item
  for item in $SUPPORTED_KINDS; do if [[ "$item" == "$k" ]]; then return 0; fi; done
  return 1
}
choose_kind_tui() {
  # Interactive TUI agent kind menu.
  # Renders to stderr and reads one line from stdin.
  # Falls back to kind=opencode on EOF/timeout/non-TTY so it never hangs.
  {
    msg kind.menu.title
    msg kind.menu.item1
    printf '  2) claude   - Anthropic Claude Code\n'
    printf '  3) codex    - OpenAI Codex / CLI\n'
    printf '  4) agy      - Google Antigravity Agent\n'
    msg kind.menu.prompt
  } >&2
  local ans=""
  if IFS= read -r -t 10 ans <&0 2>/dev/null; then
    ans="$(printf '%s' "$ans" | tr '[:upper:]' '[:lower:]' | tr -d '[:space:]')"
    case "$ans" in
      ""|1|opencode) printf 'opencode' ;;
      2|claude) printf 'claude' ;;
      3|codex) printf 'codex' ;;
      4|agy) printf 'agy' ;;
      *)
        if is_known_kind "$ans"; then
          printf '%s' "$ans"
        else
          msg kind.err.unknown "$ans" >&2; exit 2
        fi
        ;;
    esac
  else
    printf 'opencode'
  fi
}

if [[ "$LIST_PRESETS" -eq 1 ]]; then list_presets; exit 0; fi
# 환경변수 폴백 (명시적 --preset이 우선)
if [[ -z "$PRESET_ARG" && -n "${HERDR_TEAM_PRESET:-}" ]]; then PRESET_ARG="$HERDR_TEAM_PRESET"; fi
if [[ -n "$PRESET_ARG" ]]; then
  if ! is_known_preset "$PRESET_ARG"; then
    msg preset.err.cli.unknown "$PRESET_ARG" "$(preset_usage_list)" >&2; exit 2
  fi
  PRESET="$(alias_target "$PRESET_ARG")"
  if [[ "$PRESET" != "$PRESET_ARG" ]]; then
    msg preset.warn.deprecated "$PRESET_ARG" "$PRESET" >&2
  fi
else
  if [[ "$NO_INTERACTIVE" -eq 1 ]]; then
    PRESET="dev"
  else
    PRESET="$(choose_preset_tui)"
  fi
fi

# preset.conf 존재 검증 (CLI/ENV/TUI 공통; discovery가 비어도 원시 grep 대신 명시 에러)
if [[ -z "$(preset_dir "$PRESET" 2>/dev/null || true)" ]]; then
  _found="$(preset_usage_list)"
  if [[ "$_found" == "(none)" || "$_found" == "(없음)" ]]; then
    msg preset.err.conf.missing "$PRESET" "$TEMPLATE_DIR" "$SCRIPT_DIR/../templates" >&2
  else
    msg preset.err.conf.missing.found "$PRESET" "$_found" "$TEMPLATE_DIR" "$SCRIPT_DIR/../templates" >&2
  fi
  exit 2
fi

# agent kind 해결: 명시적 --kind > HERDR_TEAM_KIND > TUI 메뉴 > opencode
if [[ -z "$KIND_ARG" && -n "${HERDR_TEAM_KIND:-}" ]]; then KIND_ARG="$HERDR_TEAM_KIND"; fi
if [[ -n "$KIND_ARG" ]]; then
  if ! is_known_kind "$KIND_ARG"; then
    msg kind.err.unknown.cli "$KIND_ARG" >&2; exit 2
  fi
  KIND="$KIND_ARG"
else
  if [[ "$NO_INTERACTIVE" -eq 1 ]]; then
    KIND="opencode"
  else
    KIND="$(choose_kind_tui)"
  fi
fi

# layout 해결: 명시적 --layout > HERDR_TEAM_LAYOUT > preset.conf LAYOUT > 2col
if [[ -z "$LAYOUT_ARG" && -n "${HERDR_TEAM_LAYOUT:-}" ]]; then LAYOUT_ARG="$HERDR_TEAM_LAYOUT"; fi
PRESET_LAYOUT="$(grep -E '^LAYOUT=' "$(preset_dir "$PRESET" 2>/dev/null)/preset.conf" 2>/dev/null | sed -e 's/^LAYOUT=//' -e 's/^"//' -e 's/"$//' | head -n1 || true)"
LAYOUT="${LAYOUT_ARG:-${PRESET_LAYOUT:-2col}}"
case "$LAYOUT" in
  2col|right-stack) ;;
  *) msg layout.unknown "$LAYOUT" >&2; exit 2 ;;
esac

# --- 역할 일반화: preset.conf의 ROLES에서 에이전트명 도출 ---
PRESET_ROLES="$(grep -E '^ROLES=' "$(preset_dir "$PRESET" 2>/dev/null)/preset.conf" 2>/dev/null | sed -e 's/^ROLES=//' -e 's/^"//' -e 's/"$//' | head -n1)"
if [[ -z "$PRESET_ROLES" ]]; then echo "error: preset '$PRESET'의 ROLES가 없거나 비어 있습니다 ($(preset_dir "$PRESET" 2>/dev/null || printf '%s' "$PRESET")/preset.conf 확인)." >&2; exit 2; fi
# shellcheck disable=SC2206: 의도적 워드 스플릿
ROLES=($PRESET_ROLES)
NUMERALS=(② ③ ④ ⑤ ⑥)
role_agent() { printf '%s-%s' "$PREFIX" "$1"; }
PLANNER="$(role_agent planner)"
WORKER="$(role_agent worker)"
REVIEWER="$(role_agent reviewer)"

# --- 프리셋별 문서 격리 (agents/<preset>/) 헬퍼 ---
preset_state_file() { printf '%s/.herdr-team/preset' "$CWD"; }
active_preset() {
  local f; f="$(preset_state_file)"
  [[ -f "$f" ]] || return 0
  head -n1 "$f" | tr -d '[:space:]'
}
set_active_preset() {
  local p="$1"
  if [[ "$DRY_RUN" -eq 1 ]]; then
    printf '+ printf %s > .herdr-team/preset\n' "'$p\\n'"
    return 0
  fi
  mkdir -p "$CWD/.herdr-team"
  printf '%s\n' "$p" > "$(preset_state_file)"
}
canonical_dir() { printf '%s/agents/%s' "$CWD" "$PRESET"; }
subst_tpl() {
  local p r
  p="$(printf '%s' "$PREFIX" | sed -e 's/[\\&/]/\\&/g')"
  r="$(printf '%s' "$PRESET" | sed -e 's/[\\&/]/\\&/g')"
  sed -e "s/{{PREFIX}}/$p/g" -e "s/{{PRESET}}/$r/g" "$1"
}
legacy_role_docs() {
  ls "$CWD/agents/" 2>/dev/null | grep -E "^${PREFIX}-(planner|worker|reviewer|researcher|orchestrator|taskmanager)\.md$" || true
}
# --- 온보딩 안전성 유틸 (R1 gitignore 멱등 / R2 관리 섹션 병합 / R3 가드) ---
# 명세: docs/specs/safe-onboarding-spec.md
MANAGED_BEGIN_RE='^<!-- herdr-team:managed BEGIN [(]preset=[^)]*[)] -->$'
MANAGED_END_LINE='<!-- herdr-team:managed END -->'

managed_scan() {  # $1=파일 $2=state|preamble|interior — 마커는 "라인 전체 일치"만 인정
  [[ -f "$1" ]] || { [[ "$2" == "state" ]] && printf 'none'; return 0; }
  awk -v file="$1" -v bre="$MANAGED_BEGIN_RE" -v el="$MANAGED_END_LINE" -v mode="$2" '
    function out(line) {
      if (mode == "state") return
      if (ib) { if (mode == "interior") print line }
      else if (mode == "preamble") print line
    }
    BEGIN {
      while ((getline line < file) > 0) {
        n++; L[n] = line
        if (line ~ /^[[:space:]]*(```|~~~)/) nf++
      }
      close(file)
      fences = (nf % 2 == 0)
      for (i = 1; i <= n; i++) {
        line = L[i]
        if (fences && line ~ /^[[:space:]]*(```|~~~)/) { f = !f; out(line); continue }
        if (!f && line ~ bre) { b++; if (!ib) { ib = 1; if (!fb) fb = i } continue }
        if (!f && line == el) { e++; if (ib) { ib = 0; if (!fe) fe = i } continue }
        out(line)
      }
      if (mode != "state") exit
      if (b == 0 && e == 0) print "none"
      else if (b >= 2 || e >= 2) print "multi"
      else if (b == 1 && e == 1 && fb < fe) print "single"
      else print "broken"
    }
  '
}
managed_state() { managed_scan "$1" state; }  # none | single | multi | broken
managed_part() { managed_scan "$1" "$2"; }    # preamble(블록 밖) | interior(블록 안)
managed_block() {  # $1=preset $2=본문 파일 → stdout: 마커로 감싼 관리 섹션
  printf '<!-- herdr-team:managed BEGIN (preset=%s) -->\n' "$1"
  [[ -s "$2" ]] && awk '{ print }' "$2"
  printf '%s\n' "$MANAGED_END_LINE"
}
managed_recompose() {  # $1=preamble 파일 $2=본문 파일 $3=preset → stdout
  [[ -s "$1" ]] && awk '{ print }' "$1"
  managed_block "$3" "$2"
}
atomic_write() {  # $1=dest, stdin=내용 — 심링크는 링크 대상에 쓰고 링크는 보존, tmp → mv 원자 교체
  local dest="$1" real tmp perm=""
  real="$dest"
  if [[ -L "$dest" ]]; then
    real="$(readlink -f -- "$dest" 2>/dev/null || true)"
    [[ -n "$real" ]] || real="$(realpath -- "$dest" 2>/dev/null || true)"
    if [[ -z "$real" ]]; then echo "error: 심링크 대상 해석 실패: $dest" >&2; return 1; fi
  fi
  if [[ -d "$real" ]]; then
    echo "error: $real 가 디렉터리입니다 — 파일로 교체할 수 없습니다." >&2; return 1
  fi
  if [[ -e "$real" ]]; then
    perm="$(stat -c '%a' "$real" 2>/dev/null || stat -f '%Lp' "$real" 2>/dev/null || true)"
  fi
  if ! tmp="$(mktemp "$(dirname "$real")/.herdr-team.tmp.XXXXXX" 2>/dev/null)"; then
    echo "error: 쓸 수 없습니다: $real (디렉터리 쓰기 권한 확인)" >&2; return 1
  fi
  if ! cat > "$tmp"; then rm -f "$tmp"; echo "error: 쓰기 실패: $real" >&2; return 1; fi
  chmod "${perm:-644}" "$tmp" 2>/dev/null || true
  if ! mv "$tmp" "$real"; then rm -f "$tmp"; echo "error: 교체 실패: $real" >&2; return 1; fi
}
backup_root_agents() {  # $1=루트 AGENTS.md → 백업 경로 stdout (타임스탬프 충돌 시 .N)
  local dir="$CWD/.herdr-team/backup" ts dest n=1
  mkdir -p "$dir" || { echo "error: 백업 디렉터리 생성 실패: $dir" >&2; return 1; }
  ts="$(date -u +%Y%m%dT%H%M%SZ)"
  dest="$dir/AGENTS.md.$ts.bak"
  while [[ -e "$dest" ]]; do n=$((n+1)); dest="$dir/AGENTS.md.$ts.bak.$n"; done
  cp -p "$1" "$dest" || { echo "error: 백업 실패: $1" >&2; return 1; }
  printf '%s' "$dest"
}
guard_preconditions() {  # G1~G5: 어떤 쓰기도 전에 fail-fast (종료코드 2)
  local root="$CWD/AGENTS.md" lower="$CWD/agents.md" entry path label
  # G1: 대소문자 충돌 — 소문자만 있어도 선제 차단(도구가 2회차 데드락을 만들지 않도록)
  if [[ -e "$lower" ]] && { [[ ! -e "$root" ]] || ! [[ "$root" -ef "$lower" ]]; }; then
    echo "error: 소문자 agents.md 가 존재합니다 — 루트 팀 문서는 AGENTS.md 이며 별개 파일이 됩니다 (대소문자 충돌)." >&2
    echo "  - $lower" >&2
    if [[ -e "$root" ]]; then echo "  - $root" >&2; fi
    echo "  agents.md 를 AGENTS.md 로 통합(이름 변경/삭제)한 뒤 재실행하세요 (루트 AGENTS.md 쓰기 중단)." >&2
    return 2
  fi
  for entry in "$CWD/agents|agents/<preset>/" "$CWD/agents/$PRESET|agents/$PRESET/" "$CWD/.herdr-team|.herdr-team/"; do
    path="${entry%%|*}"; label="${entry#*|}"
    if [[ -e "$path" && ! -d "$path" ]]; then
      echo "error: $path 가 디렉터리가 아닙니다 — $label 시딩에 실패합니다. 파일을 정리 후 재실행하세요." >&2
      return 2
    fi
  done
  # G5: 관리 섹션 마커 상태 (라인 전체 일치 기준)
  if [[ -f "$root" ]]; then
    case "$(managed_state "$root")" in
      multi)
        echo "error: $root 의 herdr-team 관리 섹션 마커가 2쌍 이상입니다 — 중복 마커를 1쌍만 남긴 뒤 재실행하세요." >&2
        return 2 ;;
      broken)
        echo "error: $root 의 herdr-team 관리 섹션 마커 쌍이 맞지 않습니다 (BEGIN/END 불일치) — 수동 편집을 확인한 뒤 재실행하세요." >&2
        return 2 ;;
    esac
  fi
  return 0
}
gitignore_normalize() {  # 선행/후행 공백·행 끝 주석·후행 슬래시 정규화 (E3)
  printf '%s' "$1" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]#.*$//' -e 's/[[:space:]]*$//' -e 's:/*$::'
}
gitignore_has() {  # $1=.gitignore $2=항목 토큰(.herdr-team|.opencode)
  [[ -f "$1" ]] || return 1
  local line
  while IFS= read -r line; do
    [[ "$(gitignore_normalize "$line")" == "$2" ]] && return 0
  done < "$1"
  return 1
}
ensure_gitignore() {  # R1: 부족분만 1회 append (멱등·원자적·기존 바이트 보존)
  if [[ "$NO_GITIGNORE" -eq 1 ]]; then log "gitignore 보강 생략(--no-gitignore)"; return 0; fi
  local gi="$CWD/.gitignore" t add=()
  if ! git -C "$CWD" rev-parse --show-toplevel >/dev/null 2>&1; then
    log "git 저장소가 아니므로 .gitignore 보강 생략: $CWD"; return 0
  fi
  if [[ -e "$gi" && ! -f "$gi" ]]; then
    echo "error: $gi 가 일반 파일이 아닙니다 — .gitignore 무시 등록에 실패합니다. 파일을 정리 후 재실행하세요." >&2
    return 1
  fi
  for t in .herdr-team .opencode; do gitignore_has "$gi" "$t" || add+=("$t/"); done
  if [[ ${#add[@]} -eq 0 ]]; then
    if [[ "$DRY_RUN" -eq 1 ]]; then printf '+ gitignore: 이미 있음 → %s\n' "$gi"; fi
    return 0
  fi
  if [[ "$DRY_RUN" -eq 1 ]]; then
    printf '+ gitignore: append %s → %s\n' "${add[*]}" "$gi"
    return 0
  fi
  {
    if [[ -f "$gi" ]]; then
      cat "$gi"
      if [[ -n "$(tail -c1 "$gi")" ]]; then printf '\n'; fi
    fi
    printf '# herdr-team\n'
    printf '%s\n' "${add[@]}"
  } | atomic_write "$gi" || return 1
  log "gitignore 보강: ${add[*]} → $gi"
}

sync_root_agents() {
  local active canon root
  active="$(active_preset)"
  if [[ -n "$active" ]] && ! is_known_preset "$active"; then
    echo "[herdr-team] 경고: 알 수 없는 active preset '$active' → write-back 생략, '$PRESET'로 활성화" >&2
    active=""
  fi
  canon="$(canonical_dir)"
  root="$CWD/AGENTS.md"
  local tmpd
  tmpd="$(mktemp -d)"
  # (4a) 아웃고잉 스냅샷: 루트 관리 섹션의 "내부"만 정본으로 — 사용자 본문(preamble)은 정본에 기록하지 않는다
  if [[ -f "$root" && -n "$active" && "$active" != "$PRESET" && "$FORCE" -eq 0 ]]; then
    if [[ "$(managed_state "$root")" == "single" ]]; then
      mkdir -p "$CWD/agents/$active"
      managed_part "$root" interior > "$tmpd/body"
      managed_block "$active" "$tmpd/body" | atomic_write "$CWD/agents/$active/AGENTS.md" \
        || { rm -rf "$tmpd"; return 1; }
      log "write-back: AGENTS.md → agents/${active}/AGENTS.md (관리 섹션 내부만)"
    else
      log "write-back 생략: AGENTS.md 에 관리 섹션이 없습니다 (사용자 본문은 루트에 유지)"
    fi
  fi
  # (4b) 인커밍 활성화: 백업 → 관리 섹션만 치환(사용자 본문 보존) → 원자적 쓰기. 정본은 순수 내용 유지
  if [[ ! -f "$root" ]]; then
    atomic_write "$root" < "$canon/AGENTS.md" || { rm -rf "$tmpd"; return 1; }
    log "activate: agents/${PRESET}/AGENTS.md → AGENTS.md"
  elif [[ "$FORCE" -eq 1 || "$active" != "$PRESET" ]]; then
    managed_part "$root" preamble > "$tmpd/pre"
    if [[ "$(managed_state "$canon/AGENTS.md")" == "single" ]]; then
      managed_part "$canon/AGENTS.md" interior > "$tmpd/body"
    else
      awk '{ print }' "$canon/AGENTS.md" > "$tmpd/body"
    fi
    managed_recompose "$tmpd/pre" "$tmpd/body" "$PRESET" > "$tmpd/merged"
    local bak=""
    # --force: 변경 유무와 무관하게 백업 선행 (spec §2 R2)
    if [[ "$FORCE" -eq 1 && "$NO_BACKUP" -eq 0 ]]; then
      bak="$(backup_root_agents "$root")" || { rm -rf "$tmpd"; return 1; }
      log "백업: ${bak#"$CWD"/}"
    fi
    if ! cmp -s "$tmpd/merged" "$root"; then
      if [[ -z "$bak" && "$NO_BACKUP" -eq 0 ]]; then
        bak="$(backup_root_agents "$root")" || { rm -rf "$tmpd"; return 1; }
        log "백업: ${bak#"$CWD"/}"
      fi
      atomic_write "$root" < "$tmpd/merged" || { rm -rf "$tmpd"; return 1; }
      log "activate: agents/${PRESET}/AGENTS.md → AGENTS.md (관리 섹션 치환, 사용자 본문 보존)"
    fi
  fi
  rm -rf "$tmpd"
}

# --- watcher 옵트인 백그라운드 기동 (R3) ---
# 비차단 원칙: 어떤 실패도 ht 종료코드에 반영하지 않는다(경고 1행 후 계속).
watcher_running() {  # $1=pidfile → 이미 가동 중이면 0
  local pf="$1" pid
  [[ -f "$pf" ]] || return 1
  pid="$(tr -cd '0-9' < "$pf" 2>/dev/null)"
  [[ -n "$pid" ]] || return 1
  kill -0 "$pid" 2>/dev/null || return 1
  # PID 재사용 오탐 방지: cmdline 확인(/proc 없는 플랫폼은 생존만으로 판단)
  if [[ -r "/proc/$pid/cmdline" ]]; then
    tr '\0' ' ' < "/proc/$pid/cmdline" | grep -q 'herdr-watcher' || return 1
  fi
  return 0
}
start_watcher() {
  if [[ "$NO_START" -eq 1 ]]; then log "watcher 생략: --no-start (감시할 agent 없음)"; return 0; fi
  if [[ "$TEMPLATES_ONLY" -eq 1 ]]; then log "watcher 생략: --templates-only (pane 미분할)"; return 0; fi
  local pidfile="$CWD/.herdr-team/watcher.pid" logfile="$CWD/.herdr-team/watcher.log" wbin=""
  wbin="$(command -v herdr-watcher 2>/dev/null || true)"
  if [[ -z "$wbin" && -x "$SCRIPT_DIR/../bin/herdr-watcher" ]]; then wbin="$SCRIPT_DIR/../bin/herdr-watcher"; fi
  if [[ -z "$wbin" ]]; then log "WARN: herdr-watcher 를 찾을 수 없습니다 → watcher 기동 생략"; return 0; fi
  if [[ "$DRY_RUN" -eq 1 ]]; then
    printf '+ watcher: start --prefix %s --cwd %s → .herdr-team/watcher.log (pidfile %s)\n' "${PREFIX}-" "$CWD" ".herdr-team/watcher.pid"
    return 0
  fi
  if ! command -v python3 >/dev/null 2>&1; then log "WARN: python3 없음 → watcher 기동 생략"; return 0; fi
  if watcher_running "$pidfile"; then
    log "watcher 이미 가동 중 (pid=$(tr -cd '0-9' < "$pidfile"), pidfile $pidfile) → 생략"
    return 0
  fi
  mkdir -p "$CWD/.herdr-team"
  if [[ -d "$logfile" ]] || ! : >> "$logfile" 2>/dev/null; then
    log "WARN: watcher 로그를 쓸 수 없습니다 ($logfile) → watcher 기동 생략"; return 0
  fi
  local -a wargs=(--prefix "${PREFIX}-" --cwd "$CWD")
  if [[ "$NO_AUTO_ALLOW" -eq 1 ]]; then wargs+=(--no-auto-allow); fi
  nohup "$wbin" "${wargs[@]}" >> "$logfile" 2>&1 &
  local wpid=$!
  # 즉시 종료(설정/의존성 오류) 판별용 짧은 유예 후 생존 확인 — 실패 시 pidfile 미기록
  sleep 0.3
  if ! kill -0 "$wpid" 2>/dev/null; then
    log "WARN: watcher 기동 실패(즉시 종료) → 계속 진행 (종료코드 불변)"; rm -f "$pidfile"; return 0
  fi
  printf '%s\n' "$wpid" > "$pidfile"
  log "watcher 기동: pid=$wpid prefix=${PREFIX}- (L2 ask 팝업도 Allow once 자동 승인됩니다 — 취소: kill $wpid)"
  return 0
}

run() {
  if [[ "$DRY_RUN" -eq 1 ]]; then
    printf '+ %s\n' "$*"
  else
    # 실패 시 stdout 억제 + 종료코드 전파. 무음 소실 방지: 원인 명시 에러로 폐쇄.
    "$@" >/dev/null && return 0
    local __r=$?
    echo "error: 명령 실패: $*" >&2
    return "$__r"
  fi
}
# stdout 캡처용 실행 (세션 ID 등). dry-run이면 계획만 출력하고 아무것도 실행하지 않는다.
run_capture() {
  if [[ "$DRY_RUN" -eq 1 ]]; then
    printf '+ %s\n' "$*"
    return 0
  fi
  "$@"
}
log() { printf '[herdr-team] %s\n' "$*"; }
# herdr JSON 출력에서 pane_id 추출 (jq 기반, 버전별 필드 차이 흡수).
# split/current 응답은 {"result":{"pane":{"pane_id":"wD:p1F",...}}} 형태가 표준이며,
# 구버전/변형 응답(.result.pane_id, .pane_id, bare ID)도 순서대로 시도한다.
herdr_pane_id() {
  jq -r '
    .result.pane.pane_id
    // .result.pane_id
    // .result.id
    // .pane.pane_id
    // .pane_id
    // .id
    // empty
  ' 2>/dev/null | head -n1
}
# --- 우측 컬럼 down 분할 균등화 ratio 계산 ---
# herdr pane split --direction down --ratio F 는 "분할 대상 pane이 보유하는 비율"이며
# 나머지(1-F)가 새 pane에 할당된다. 우측 컬럼 역할 총수 N에 대해 k번째 down 분할
# (k=1..N-1, N=1이면 down 없음)의 균등 ratio = 1/(N-k+1).
# 예) N=4: k=1→1/4=0.25, k=2→1/3≈0.333333, k=3→1/2=0.5 → 새 pane 4개가 각 1/N로 균등.
# 주의: ratio를 i/(i+1)로 계산하면 0.5/0.666667/0.75가 되어 균등화되지 않는다.
# python3 의존을 피하려 POSIX awk로 산출 (bash 3.x 호환).
down_split_ratio() {
  local n="$1" k="$2" v
  v="$(awk -v n="$n" -v k="$k" 'BEGIN { printf "%.6f", 1.0 / (n - k + 1) }')"
  v="${v%"${v##*[!0]}"}"   # 후행 0 제거: 0.250000 → 0.25
  printf '%s' "${v%.}"     # 후행 소수점 제거 방어: 1.000000 → 1
}

# --- pane ready 대기: agent_pane_busy(shell 미준비 race) 결정론 해소 ---
# 실측 근거(spec §4.2 검증 완료, herdr 0.9.3 — tests/test_pane_ready.sh 헤더):
# - `pane run`: 즉시 반환(rc=0), 명령은 pty 입력으로 큐잉(완료 대기 아님).
# - `pane wait-output`: 즉시 검색 후 폴링, --timeout 폐쇄, 정규식 지원.
# - process-info 스키마(실측): foreground_processes[0]/{name,pid}, shell_pid, foreground_process_group_id.
#   foreground_process_group_id == shell_pid ⇔ pane shell이 foreground 소유(점유 아님);
#   busy pane(foreground sleep/vim)에서는 불일치 — 결정론적 busy 판정.
# 채택 조합(spec §2.1 D+B+C보조): 프로세스 gate(C) → 마커 프로브+평탄화 허용 정규식(D).
#   리터럴 --match는 busy pane 타이핑 에코를 매치하는 false positive가 있어(실측) 라인 시작
#   앵커 정규식을 사용한다; `$` 앵커는 스냅샷 라인 공백 패딩 + 프롬프트 평탄화로 불안정(실측).
READY_TIMEOUT_S="${HERDR_TEAM_READY_TIMEOUT_S:-20}"  # 전역 참조 노출 유지 (주입 이용자 대응)
HT_READY_MARKER="__HT_READY_MARKER__"
pane_shell_foreground() {
  local _out _spid _pgid
  _out="$(herdr pane process-info --pane "$1" 2>/dev/null)" || return 1
  _spid="$(printf '%s' "$_out" | jq -r '.result.process_info.shell_pid // empty')"
  _pgid="$(printf '%s' "$_out" | jq -r '.result.process_info.foreground_process_group_id // empty')"
  [[ -n "$_spid" && -n "$_pgid" && "$_pgid" == "$_spid" ]]
}
wait_pane_ready() {
  local _pane="$1" _start=$SECONDS _n=0 _limit="${HERDR_TEAM_READY_TIMEOUT_S:-$READY_TIMEOUT_S}"
  until pane_shell_foreground "$_pane"; do
    (( SECONDS - _start < _limit )) || {
      echo "error: pane ${_pane} ready 대기 초과 (${_limit}s)" >&2
      echo "error: 대상 pane에서 foreground 프로세스(vim 등)가 shell을 점유 중이면 종료 후 재실행해야 합니다." >&2
      return 1
    }
    _n=$((_n+1))
    log "pane ${_pane} shell foreground 대기 중 (attempt ${_n})"
    # 페이싱: wait-output 내장 폴링으로 재시도 간격 확보 (매칭 불가능 패턴, 0.5s 폐쇄)
    herdr pane wait-output "$_pane" --match "${HT_READY_MARKER}:no-op" --timeout 500 >/dev/null 2>&1 || true
  done
  # shell이 프로브 명령을 실제 실행해 출력했음을 이벤트로 확정 — 타이핑 에코("printf ...")와
  # 구별 위해 라인 시작 앵커. 스냅샷 공백 패딩·프롬프트 평탄화 때문에 `$` 앵커는 미사용.
  until herdr pane run "$_pane" printf "$HT_READY_MARKER" >/dev/null 2>&1 \
        && herdr pane wait-output "$_pane" --regex "(?m)^[ \t]*${HT_READY_MARKER}" --timeout 1500 >/dev/null 2>&1; do
    (( SECONDS - _start < _limit )) || {
      echo "error: pane ${_pane} ready 대기 초과 (${_limit}s)" >&2
      echo "error: 대상 pane에서 foreground 프로세스(vim 등)가 shell을 점유 중이면 종료 후 재실행해야 합니다." >&2
      return 1
    }
    _n=$((_n+1))
    log "pane ${_pane} ready 대기 중 (attempt ${_n})"
  done
}

# --- 권한 모델(계층형 번들 + 역할 프로파일) 병합/시딩 ---
# 명세: docs/specs/permission-model-optimization-spec.md §c/§d/§e
# baseline(L0/L2/L3) + bundle*(L0/L1 도메인) + profile/<preset>/<role>(역할 경계) 순으로
# permissions를 이어 붙여 last-match-wins 판정을 결정적으로 만든다(뒤 규칙이 우선).
permissions_strip_jsonc() {  # 전체 줄 주석(//) 제거 → 순수 JSON
  sed -e 's/^[[:space:]]*\/\/.*$//' "$1"
}
permissions_src_dir() {  # preset-local > --template-dir > 번들 (기존 템플릿 해석 순서 준용)
  local c
  if [[ -n "${PERMISSIONS_DIR:-}" && -f "$PERMISSIONS_DIR/baseline.json" ]]; then printf '%s' "$PERMISSIONS_DIR"; return 0; fi
  for c in "$(preset_dir "$PRESET" 2>/dev/null || true)/permissions" "$TEMPLATE_DIR/permissions" "$SCRIPT_DIR/../templates/permissions"; do
    if [[ -n "$c" && -f "$c/baseline.json" ]]; then printf '%s' "$c"; return 0; fi
  done
  return 1
}
permissions_merge_role() {  # $1=role → stdout: baseline+includes+profile 병합 JSON (순수 함수형)
  local role="$1" src prof b tmp out
  src="$(permissions_src_dir)" || return 1
  prof="$src/profile/$PRESET/$role.json"
  [[ -f "$prof" ]] || return 1
  tmp="$(mktemp)"; out=""
  printf '[' > "$tmp"
  local first=1
  for b in $(jq -r '.includes[]' "$prof"); do
    [[ -f "$src/bundle/$b.json" ]] || { rm -f "$tmp"; echo "error: bundle 없음: $b ($prof)" >&2; return 1; }
    [[ "$first" -eq 1 ]] || printf ',' >> "$tmp"
    permissions_strip_jsonc "$src/baseline.json" >/dev/null
    cat "$src/bundle/$b.json" >> "$tmp"; first=0
  done
  printf ']' >> "$tmp"
  out="$(jq -n \
      --slurpfile base <(permissions_strip_jsonc "$src/baseline.json") \
      --slurpfile bundles "$tmp" \
      --slurpfile prof <(permissions_strip_jsonc "$prof") '
        ($bundles[0] // []) as $b
        | ($b | map(.permissions // []) | add // []) as $bp
        | ($b | map(.policies // []) | add // []) as $bpol
        | {
            baseline_note: ($base[0].note // ""),
            permissions: (($base[0].permissions // []) + $bp + ($prof[0].permissions // [])),
            policies: ((($base[0].policies // []) + $bpol + ($prof[0].policies // [])) | unique_by(.resource))
          }')" || { rm -f "$tmp"; return 1; }
  rm -f "$tmp"
  printf '%s' "$out"
}
permissions_glob_to_regex() {  # glob → 정규식 (opencode v2.0.32 엔진 매처 의미론 복제)
  # 엔진: 백슬래시→'/', [.+^${}()|[]\] 이스케이프(^는 리터럴), *→.*, ?→.,
  #       후행 " .*" 는 "( .*)?" 로 완화, 전체 ^...$ 앵커.
  printf '%s' "$1" | tr '\\' '/' | awk '
    {
      s = $0; out = ""
      for (i = 1; i <= length(s); i++) {
        c = substr(s, i, 1)
        if (c == "*") out = out ".*"
        else if (c == "?") out = out "."
        else if (index(".+^${}()|[]", c) > 0) out = out "\\" c
        else out = out c
      }
      if (out ~ / \.\*$/) out = substr(out, 1, length(out) - 3) "( .*)?"
      print "^" out "$"
    }'
}
permissions_judge() {  # $1=병합 json 파일 $2=action $3=resource → allow|ask|deny
  local f="$1" act="$2" res="$3" pres pat a r e key
  key="${act}:${res}"; key="${key//\\//}"
  # 1) policies hard-deny — 엔진과 동일하게 "action:resource" 전체 문자열을 전체 앵커로 매칭
  while IFS= read -r pres; do
    [[ -n "$pres" ]] || continue
    pat="$(permissions_glob_to_regex "$pres")"
    if [[ "$key" =~ $pat ]]; then printf 'deny'; return 0; fi
  done < <(jq -r '(.policies // [])[] | select(.effect == "deny") | .resource' "$f")
  # 2) permissions: 선언 순서대로 스캔, 마지막 매칭이 승리 (last-match-wins)
  e="ask"; res="${res//\\//}"
  while IFS=$'\t' read -r a r e2; do
    [[ "$a" == "$act" ]] || continue
    pat="$(permissions_glob_to_regex "$r")"
    if [[ "$res" =~ $pat ]]; then e="$e2"; fi
  done < <(jq -r '(.permissions // [])[] | [.action, .resource, .effect] | @tsv' "$f")
  printf '%s' "$e"
}
permissions_yaml_block() {  # $1=병합 json 파일 → stdout: frontmatter YAML (permissions만)
  # V2 스키마 실측: agent 설정(Config.AgentEncoded)의 허용 키는 description/mode/permissions/model 등이며
  # `policies`는 agent 레벨에 존재하지 않는다(additionalProperties:false → 무효·권한 블록 붕괴 실측).
  # 따라서 L3 hard-deny policies는 프로젝트 .opencode/opencode.jsonc(top-level)에만 둔다.
  local f="$1"
  printf 'permissions:\n'
  jq -r '(.permissions // [])[] | "  - action: \(.action)\n    resource: \"\(.resource | gsub("\\\\"; "\\\\") | gsub("\""; "\\\""))\"\n    effect: \(.effect)"' "$f"
}
permissions_inject_frontmatter() {  # $1=agent md $2=yaml block 파일 — V1 permission 블록을 V2 permissions/policies로 교체
  local f="$1" block="$2" tmp
  tmp="$(mktemp)"
  awk -v blockfile="$block" '
    function emit(   line) { while ((getline line < blockfile) > 0) print line; close(blockfile) }
    NR == 1 && $0 == "---" { fm = 1; print; next }
    fm && $0 == "---" { if (!emitted) { emit(); emitted = 1 } print; fm = 0; next }
    fm && /^(permission|permissions|policies):/ { skip = 1; next }
    fm && skip && /^[[:space:]]/ { next }
    fm && skip && /^$/ { next }
    fm && skip { skip = 0 }
    { print }
    END { if (fm && !emitted) emit() }
  ' "$f" > "$tmp" && mv "$tmp" "$f"
}
permissions_merge_project_file() {  # $1=기존 jsonc $2=신규(우리) json → stdout 병합 JSON
  local existing="$1" ours="$2" user
  permissions_strip_jsonc "$existing" | jq -e . >/dev/null 2>&1 || return 1
  user="$(permissions_strip_jsonc "$existing" | jq -c .)"
  jq -n -c --argjson u "$user" --slurpfile o "$ours" '
    ($u) as $u
    | ($o[0]) as $o
    | (($u.permissions // []) + []) as $up
    | ($up | map([.action, .resource])) as $uk
    | ($up | map(select(.action == "shell" and .resource == "*")) | length) as $user_has_star
    | ($o.permissions // []) as $op
    | ($op | map(select(
         ([.action, .resource]) as $k
         | (($uk | index($k)) == null)
           and (((.action == "shell" and .resource == "*") and $user_has_star > 0) | not)
       ))) as $added
    | ($u
       + { permissions: ($up + $added),
           policies: ((($u.policies // []) + ($o.policies // [])) | unique_by([.action, .resource])) }
       + (if ($u["$schema"] // null) == null then { "$schema": $o["$schema"] } else {} end))'
}
setup_permissions() {  # 시딩: .opencode/opencode.jsonc(기존 사용자 파일 보존 병합) + agent frontmatter(V2 permissions/policies)
  if [[ "$NO_TEMPLATE" -eq 1 ]]; then log "권한 시딩 생략(--no-template)"; return; fi
  local src=""
  src="$(permissions_src_dir 2>/dev/null || true)"
  if [[ -z "$src" ]]; then log "permissions 템플릿 없음 → 권한 시딩 생략"; return; fi
  local dest="$CWD/.opencode" global="$CWD/.opencode/opencode.jsonc" role
  if [[ "$DRY_RUN" -eq 1 ]]; then
    printf '+ permissions: merge baseline=%s → %s (기존 파일 보존 병합, .bak 백업)\n' "$src" "$global"
    printf '+ permissions: merge profile/%s/<role>.json → .opencode/agents/%s-<role>.md frontmatter (V2 permissions/policies)\n' "$PRESET" "$PREFIX"
    return 0
  fi
  mkdir -p "$dest/agents"
  local base_json
  base_json="$(jq -n --slurpfile base <(permissions_strip_jsonc "$src/baseline.json") '{
      "$schema": "https://opencode.ai/config.json",
      permissions: ($base[0].permissions // []),
      policies: (($base[0].policies // []) | unique_by([.action, .resource]))
    }')" || return 1
  if [[ -f "$global" ]]; then
    cp -p "$global" "$global.bak"
    log "기존 .opencode/opencode.jsonc 백업: opencode.jsonc.bak"
    if merged="$(permissions_merge_project_file "$global" <(printf '%s' "$base_json"))"; then
      {
        printf '// AUTO-GENERATED by herdr-team (preset=%s) — 기존 사용자 설정 보존 병합\n' "$PRESET"
        printf '// 주의: shell "*": allow 를 수동 추가하면 L2 ask 방어가 꺼집니다(사용자 책임).\n'
        printf '// ⚠️ 권한 자기 변조 방어는 edit 도구 한정입니다(best-effort): shell(sed -i / cp / mv / echo >)로는\n'
        printf '//    .opencode/**, .herdr-team/**, .git/hooks/** 쓰기를 완전히 막지 못합니다 — 신뢰 경계로 보지 마세요.\n'
        printf '%s' "$merged" | jq .
      } > "$global"
      log "권한 병합: .opencode/opencode.jsonc (사용자 키 보존 + baseline L0/L2/L3)"
    else
      log "경고: 기존 .opencode/opencode.jsonc JSON 파싱 실패 → 원본 유지(백업만 생성)"
    fi
  else
    {
      printf '// AUTO-GENERATED by herdr-team (preset=%s) — 수동 편집 금지\n' "$PRESET"
      printf '// 계층형 권한: baseline.json(L0/L2/L3 policies) + 역할별 allow는 agents/%s-<role>.md frontmatter\n' "$PREFIX"
      printf '// 주의: shell "*": allow 를 수동 추가하면 L2 ask 방어가 꺼집니다(사용자 책임).\n'
      printf '// ⚠️ 권한 자기 변조 방어는 edit 도구 한정입니다(best-effort): shell(sed -i / cp / mv / echo >)로는\n'
      printf '//    .opencode/**, .herdr-team/**, .git/hooks/** 쓰기를 완전히 막지 못합니다 — 신뢰 경계로 보지 마세요.\n'
      printf '%s' "$base_json" | jq .
    } > "$global"
    log "권한 생성: .opencode/opencode.jsonc (baseline: L0/L2 + L3 hard-deny)"
  fi
  case " ${ROLES[*]} " in
    *" worker "*) log "경고: edit deny-list 는 edit 도구 한정 — shell(sed -i/cp/mv/echo >) 우회는 차단하지 않습니다(best-effort)." ;;
  esac
  for role in "${ROLES[@]}"; do
    local merged prof="$src/profile/$PRESET/$role.json" md="$dest/agents/$PREFIX-$role.md" blk
    [[ -f "$prof" ]] || { log "경고: 권한 프로파일 없음 → skip: profile/$PRESET/$role.json"; continue; }
    if ! merged="$(permissions_merge_role "$role")"; then
      echo "error: 권한 병합 실패: $PRESET/$role" >&2; return 1
    fi
    if [[ -f "$md" ]]; then
      local mj; mj="$(mktemp)"; printf '%s' "$merged" > "$mj"
      blk="$(mktemp)"; permissions_yaml_block "$mj" > "$blk"
      permissions_inject_frontmatter "$md" "$blk"; rm -f "$blk" "$mj"
      log "권한 주입: .opencode/agents/$PREFIX-$role.md frontmatter (V2 permissions/policies)"
    else
      log "경고: agent 정의 없음 → 권한 주입 skip: .opencode/agents/$PREFIX-$role.md"
    fi
  done
}
need_cmd() {
  if ! command -v "$1" >/dev/null 2>&1; then
    echo "error: '$1' 명령을 찾을 수 없습니다." >&2; exit 127
  fi
}
# 역할 agent 로 고정된 opencode 세션을 미리 만들고 session id를 stdout으로 돌려준다.
# dry-run에서는 계획 라인만 출력하고 값을 반환하지 않는다(--dry-run 면제, R6).
# location 미지정 시 $HOME에 귀속되므로(E19) 반드시 location.directory를 명시한다.
# 역할별 세션 모델: 값이 비면 opencode 기본 모델 상속(무지정).
# 근거: docs/specs/role-model-config.md (agent md frontmatter 의 model 은 v2 세션에 반영되지 않음)
# shortcut: "provider/model#variant" 미지원, 필요해지면 split("#") 확장
role_model() {
  case "$1" in
    planner) printf 'opencode-go/glm-5.3-flash' ;;
    *) printf '' ;;
  esac
}

opencode_session_for() {
  local agent="$1" var payload out sid m mp
  var="SID_$(printf '%s' "${agent#"$PREFIX"-}" | tr '[:lower:]' '[:upper:]')"
  m="$(role_model "${agent#"$PREFIX"-}")"
  mp=""
  [[ -n "$m" ]] && mp=",model:{providerID:\"${m%%/*}\",id:\"${m#*/}\"}"
  if [[ "$DRY_RUN" -eq 1 ]]; then
    printf '+ %s=$(opencode api post /api/session -d "$(jq -nc --arg a %s --arg d %q %s)" | jq -r .data.id)\n' \
      "$var" "$agent" "$CWD" "'{agent:\$a,title:\$a${mp},location:{directory:\$d}}'"
    return 0
  fi
  if ! payload="$(jq -nc --arg a "$agent" --arg d "$CWD" --arg m "$m" \
      '{agent:$a,title:$a,location:{directory:$d}} + (if $m=="" then {} else {model:($m|split("/")|{providerID:.[0],id:.[1]})} end)')"; then
    echo "error: 세션 요청 JSON 생성 실패 ($agent)" >&2
    return 1
  fi
  if ! out="$(run_capture opencode api post /api/session -d "$payload")"; then
    echo "error: 세션 생성 실패 ($agent) — opencode 설치/백그라운드 서비스 상태를 확인하세요." >&2
    return 1
  fi
  sid="$(printf '%s' "$out" | jq -r '.data.id // empty' 2>/dev/null)"
  if [[ -z "$sid" ]]; then
    echo "error: 세션 ID 파싱 실패 ($agent): ${out:-<empty>}" >&2
    return 1
  fi
  printf '%s' "$sid"
}

# --- 1) 템플릿 복사/생성 (preset별 문서 격리: agents/<preset>/) ---
write_builtin_agents_md() {
  local dst="$1" agents_list="" r
  for r in "${ROLES[@]}"; do agents_list+="$(role_agent "$r") / "; done
  agents_list="${agents_list% / }"
  cat > "$dst" <<EOF
# Agents Configuration & Team Orchestration (preset: ${PRESET})

${#ROLES[@]}인 체제(PM - ${agents_list}) 정의서입니다. (preset=${PRESET})

## 1. 소통 흐름 (Communication Flow) — 순차 파이프라인

\`\`\`
[ User ] → [ PM (agy) ] → [ $(role_agent "${ROLES[0]}") ] → [ $(role_agent "${ROLES[1]:-${ROLES[0]}}") ] → [ $(role_agent "${ROLES[2]:-${ROLES[0]}}") ] ─ [APPROVE + 실행 로그] → 보고
                                                     ↑________ [REQUEST CHANGES] ________|
\`\`\`

- \`$(role_agent "${ROLES[0]}")\`(Task Manager)가 파이프라인 중계·드라이브 전담 (코드 수정 금지).
- Team 간 직접 협업 금지. 모든 반송/승인은 Task Manager(필요 시 PM) 경유.
- 수정 권한: 코드를 직접 수정하는 것은 \`$(role_agent worker)\`뿐(해당 역할이 체제에 있을 때). 리뷰어는 수정 없이 보고서만.

### 1.1 PM 가드레일
- ❌ 금지: 파일 편집, 테스트/빌드 실행, git commit/push, pane 직접 코딩.
- ✅ 허용: \`herdr agent list/read\`, \`herdr pane list/read\`, \`git status/diff/log\` 취합 보고.
- 위임 고정: 기획→\`$(role_agent planner)\`, 실행 검증 겸 리뷰→\`$(role_agent reviewer)\`.

## 2. 에이전트 역할
| 에이전트 | 문서 |
|---|---|
| PM (agy) | 본 문서 |
EOF
  for r in "${ROLES[@]}"; do
    printf '| %s | agents/%s/%s.md |\n' "$(role_agent "$r")" "$PRESET" "$(role_agent "$r")" >> "$dst"
  done
  {
    printf '\n## 3. Herdr 운용\n'
    printf -- '- 고정 Pane ID 금지. `herdr pane/tab/agent list`로 조회.\n'
    printf -- '- `herdr-team %s --preset %s` 실행 시 현재 Pane(PM) 기준 우측 분할 후 아래로 %d분할(--ratio 균등화).\n' "$PREFIX" "$PRESET" "$((${#ROLES[@]} - 1))"
  } >> "$dst"
}

write_builtin_role_doc() {
  local dst="$1" role="$2"
  case "$role" in
    orchestrator|taskmanager) cat > "$dst" <<EOF
# Role: ${PREFIX}-orchestrator (Orchestrator — 파이프라인 오케스트레이터)

## 핵심 미션
Team이 쉼 없이 작업하도록 순차 파이프라인을 실시간 중계·드라이브. 코드 수정 금지.

## 규칙
- 역할 위임 고정: 기획/설계→\`${PREFIX}-planner\`, 구현→\`${PREFIX}-worker\`, 검증·리뷰→\`${PREFIX}-reviewer\`.
- 오케스트레이션 전담: \`herdr agent prompt\`로 위임, \`wait/read\`로 모니터링, 산출물 중계.
- 무방치 원칙: 각 단계 완료 즉시 다음 단계 연결. 모든 반송/승인은 Orchestrator(필요 시 PM) 경유.

## 보고 형식
- 진행 태스크 / 에이전트 산출물 요약(Planner 명세·Worker 테스트·Reviewer 판정) / 다음 단계.
EOF
      ;;
    planner) cat > "$dst" <<EOF
# Role: ${PLANNER} (기획 및 아키텍처 설계)

## 핵심 미션
요구사항 분석, 아키텍처/데이터 흐름 설계, \`${WORKER}\`가 즉시 구현 가능한 Task Breakdown 작성.

## 산출물
- 요구사항 요약 & 목표 / 아키텍처 & 데이터 흐름 / 작업 분할(완료 기준·TDD 대상) / 엣지 케이스.
- 직접 코드 구현 금지 (인터페이스 예시만 가능).
EOF
      ;;
    worker) cat > "$dst" <<EOF
# Role: ${WORKER} (개발 및 단위 테스트 구현)

## 핵심 미션
TDD Red→Green→Refactor로 구현하고 단위 테스트를 통과시킴.

## 보고 형식
- 작업 개요 / 변경·추가 파일 / 단위 테스트 결과 / 특이사항 & 다음 제안.
- 주요 이론 내용은 \`til/\`에 기록 후 커밋.
EOF
      ;;
    reviewer) cat > "$dst" <<EOF
# Role: ${REVIEWER} (실행 검증 겸 코드 리뷰, 최종 게이트)

## 핵심 미션
정적 리뷰 + 빌드/단위/통합·E2E·회귀 직접 실행 후 [APPROVE]/[REQUEST CHANGES] 판정.
[APPROVE]는 실행 커맨드·로그 첨부 시에만 유효. 코드 수정 금지.
EOF
      ;;
    researcher) cat > "$dst" <<EOF
# Role: $(role_agent researcher) (기술 조사·외부 리서치)

## 핵심 미션
외부 리서치, 기술 조사, 라이브러리/SDK 내부 탐사 전담 (읽기·보고만, 코드 수정 금지).
모든 주장에 출처(URL·버전·발췌)를 첨부하고 재현 절차를 기록.

## 보고 형식
- 조사 개요 / 근거 자료 / 비교 분석 / 다음 제안.
EOF
      ;;
    *) cat > "$dst" <<EOF
# Role: $(role_agent "$role") (preset: ${PRESET})

## 핵심 미션
${PRESET} 프리셋의 '${role}' 역할을 수행. PM 지시에 따라 산출물 형식을 준수.
EOF
      ;;
  esac
}

setup_templates() {
  if [[ "$NO_TEMPLATE" -eq 1 ]]; then log "템플릿 단계 생략(--no-template)"; return; fi

  ensure_gitignore

  local active canon root
  active="$(active_preset)"
  if [[ -n "$active" ]] && ! is_known_preset "$active"; then
    echo "[herdr-team] 경고: 알 수 없는 active preset '$active' → write-back 생략, '$PRESET'로 활성화" >&2
    active=""
  fi
  canon="$(canonical_dir)"
  root="$CWD/AGENTS.md"

  # 템플릿 소스 해석: 프리셋 로컬 > --template-dir > 번들
  local preset_base="" c="" agents_src="" agents_md_src=""
  preset_base="$(preset_dir "$PRESET" 2>/dev/null || true)"
  for c in "$preset_base/agents" "$TEMPLATE_DIR/agents" "$SCRIPT_DIR/../templates/agents"; do
    [[ -n "$c" && -d "$c" ]] && { agents_src="$c"; break; }
  done
  for c in "$preset_base/AGENTS.md" "$TEMPLATE_DIR/AGENTS.md" "$SCRIPT_DIR/../templates/AGENTS.md"; do
    [[ -n "$c" && -f "$c" ]] && { agents_md_src="$c"; break; }
  done
  local legacy_list=""
  legacy_list="$(legacy_role_docs)"

  # --- dry-run: 계획만 출력 (쓰기 0) ---
  if [[ "$DRY_RUN" -eq 1 ]]; then
    if [[ "$active" != "$PRESET" ]]; then
      log "preset=${PRESET} active=${active:-<none>} (전환 감지)"
    else
      log "prefix=${PREFIX} preset=${PRESET} (dry-run isolation)"
    fi
    printf '+ mkdir -p %s .herdr-team\n' "$canon"
    local role src
    for role in "${ROLES[@]}"; do
      if [[ "$FORCE" -eq 0 ]] && printf '%s\n' "$legacy_list" | grep -qx "${PREFIX}-${role}.md"; then
        printf '+ import(legacy): agents/%s-%s.md → agents/%s/%s-%s.md\n' "$PREFIX" "$role" "$PRESET" "$PREFIX" "$role"
      else
        src="$agents_src/ROLE-${role}.md"
        [[ -n "$src" && -f "$src" ]] || src="$preset_base/ROLE-${role}.md"
        if [[ -n "$src" && -f "$src" ]]; then
          printf '+ seed: %s → agents/%s/%s-%s.md\n' "$src" "$PRESET" "$PREFIX" "$role"
        else
          printf '+ seed(내장): agents/%s/%s-%s.md\n' "$PRESET" "$PREFIX" "$role"
        fi
      fi
    done
    if [[ -n "$agents_md_src" && -f "$agents_md_src" ]]; then
      printf '+ canonical: %s → agents/%s/AGENTS.md\n' "$agents_md_src" "$PRESET"
    else
      printf '+ canonical(내장): agents/%s/AGENTS.md\n' "$PRESET"
    fi
    if [[ -f "$root" && -n "$active" && "$active" != "$PRESET" && "$FORCE" -eq 0 ]]; then
      printf '+ write-back: AGENTS.md → agents/%s/AGENTS.md\n' "$active"
    fi
    if [[ -f "$root" && "$NO_BACKUP" -eq 0 ]]; then
      if [[ "$FORCE" -eq 1 || "$active" != "$PRESET" ]]; then
        printf '+ backup: AGENTS.md → .herdr-team/backup/ (타임스탬프)\n'
      fi
    fi
    if [[ ! -f "$root" || "$FORCE" -eq 1 || "$active" != "$PRESET" ]]; then
      printf '+ activate: agents/%s/AGENTS.md → AGENTS.md\n' "$PRESET"
    fi
    set_active_preset "$PRESET"
    return 0
  fi

  mkdir -p "$canon" "$CWD/.herdr-team"

  # (1) 정본 role 시딩 — 누락/강제만, 기존은 보존. 레거시 평면은 복사 import(원본 불변).
  local role
  for role in "${ROLES[@]}"; do
    local dst="$canon/${PREFIX}-${role}.md"
    [[ -f "$dst" && "$FORCE" -eq 0 ]] && continue
    if [[ "$FORCE" -eq 0 ]] && printf '%s\n' "$legacy_list" | grep -qx "${PREFIX}-${role}.md"; then
      cp "$CWD/agents/${PREFIX}-${role}.md" "$dst"
      log "import(legacy): agents/${PREFIX}-${role}.md → agents/${PRESET}/${PREFIX}-${role}.md (원본 보존)"
      continue
    fi
    local src="$agents_src/ROLE-${role}.md"
    [[ -n "$src" && -f "$src" ]] || src="$preset_base/ROLE-${role}.md"
    if [[ -n "$src" && -f "$src" ]]; then
      subst_tpl "$src" > "$dst"
    else
      write_builtin_role_doc "$dst" "$role"
    fi
  done

  # (2) 정본 AGENTS.md — 항상 프리셋 순수 내용(관리 섹션 마커로 감쌈). 루트 본문은 preamble 로만 취급
  if [[ ! -f "$canon/AGENTS.md" || "$FORCE" -eq 1 ]]; then
    local body_tmp
    body_tmp="$(mktemp)"
    if [[ -n "$agents_md_src" && -f "$agents_md_src" ]]; then
      subst_tpl "$agents_md_src" > "$body_tmp"
    else
      write_builtin_agents_md "$body_tmp"
    fi
    managed_block "$PRESET" "$body_tmp" > "$canon/AGENTS.md"
    rm -f "$body_tmp"
  fi

  # (3) 루트 활성화 (write-back + activate)
  sync_root_agents

  # (4) 상태 기록 — 반드시 마지막 (실패 시 이전 ACTIVE 유지)
  set_active_preset "$PRESET"
}

# --- 1b) opencode agent 정의 설치 (.opencode/agents/<prefix>-<role>.md) ---
# 생성물(정본은 agents/<preset>/*). 전환 시 stale prune + 활성 ROLES만 재생성.
# 같은 프리셋·비FORCE·기존 파일은 사용자 편집으로 보고 보존한다.
setup_opencode_agents() {
  if [[ "$NO_TEMPLATE" -eq 1 ]]; then log "opencode agent 단계 생략(--no-template)"; return; fi
  local preset_base="" c="" oa_src=""
  preset_base="$(preset_dir "$PRESET" 2>/dev/null || true)"
  for c in "$preset_base/opencode-agents" "$TEMPLATE_DIR/opencode-agents" "$SCRIPT_DIR/../templates/opencode-agents"; do
    [[ -n "$c" && -d "$c" ]] && { oa_src="$c"; break; }
  done
  if [[ -z "$oa_src" ]]; then log "opencode agent 템플릿 없음 → 설치 생략"; return; fi
  local dest_dir="$CWD/.opencode/agents"
  local known=" orchestrator planner worker researcher reviewer "
  local desired=() role
  for role in "${ROLES[@]}"; do
    [[ "$known" == *" $role "* ]] && desired+=("$role")
  done
  local prev="${PREV_ACTIVE:-}"

  if [[ "$DRY_RUN" -eq 1 ]]; then
    log "opencode agent sync(prune+gen): $oa_src → $dest_dir (prefix=${PREFIX})"
    local r2 want=0
    for role in orchestrator planner worker researcher reviewer; do
      want=0
      if [[ ${#desired[@]} -gt 0 ]]; then
        for r2 in "${desired[@]}"; do [[ "$r2" == "$role" ]] && want=1; done
      fi
      if [[ "$want" -eq 0 && -f "$dest_dir/${PREFIX}-${role}.md" ]]; then
        printf '+ prune: rm .opencode/agents/%s-%s.md (stale)\n' "$PREFIX" "$role"
      fi
    done
    if [[ ${#desired[@]} -gt 0 ]]; then
      for role in "${desired[@]}"; do
        [[ -f "$oa_src/ROLE-${role}.md" ]] || continue
        printf '+ gen: %s/ROLE-%s.md → .opencode/agents/%s-%s.md\n' "$oa_src" "$role" "$PREFIX" "$role"
      done
    fi
    return 0
  fi
  mkdir -p "$dest_dir"
  # (6) stale prune — 현재 prefix + known role 한정 (그 외 prefix/agent 불가침)
  local r2 want=0
  for role in orchestrator planner worker researcher reviewer; do
    want=0
    if [[ ${#desired[@]} -gt 0 ]]; then
      for r2 in "${desired[@]}"; do [[ "$r2" == "$role" ]] && want=1; done
    fi
    if [[ "$want" -eq 0 && -f "$dest_dir/${PREFIX}-${role}.md" ]]; then
      rm -f "$dest_dir/${PREFIX}-${role}.md"
      log "prune: .opencode/agents/${PREFIX}-${role}.md (stale)"
    fi
  done
  # (7) 활성 role 생성/동기화 — 같은 프리셋·비FORCE·기존 파일은 보존
  if [[ ${#desired[@]} -gt 0 ]]; then
    for role in "${desired[@]}"; do
      local osrc="$oa_src/ROLE-${role}.md"
      if [[ ! -f "$osrc" ]]; then log "경고: ROLE-${role}.md 없음 → skip"; continue; fi
      local odst="$dest_dir/${PREFIX}-${role}.md"
      if [[ -f "$odst" && "$FORCE" -eq 0 && "$prev" == "$PRESET" ]]; then
        log "opencode agent 존재 → 생략: .opencode/agents/${PREFIX}-${role}.md"
        continue
      fi
      subst_tpl "$osrc" > "$odst"
      log "opencode agent 생성: .opencode/agents/${PREFIX}-${role}.md"
    done
  fi
}

# --- 2) Pane 분할 + 리사이즈 + 레이블 + 에이전트 시작 (preset ROLES 일반화) ---
setup_panes() {
  local has_orchestrator=0 _r
  for _r in "${ROLES[@]}"; do
    if [[ "$_r" == "orchestrator" || "$_r" == "taskmanager" ]]; then has_orchestrator=1; break; fi
  done

  # dry-run은 herdr/jq 없이도 계획 출력 (TUI·인자 검증용)
  if [[ "$DRY_RUN" -eq 1 ]]; then
    log "prefix=${PREFIX} preset=${PRESET} kind=${KIND} layout=${LAYOUT} cwd=${CWD} (dry-run)"
    local _prev="BASE" _role _var _agent _i _k=0 _ratio="" _agent_flag=""
    printf '+ BASE=$(herdr pane current | jq -r .result.pane.pane_id)  # PM pane\n'
    if [[ "$LAYOUT" == "2col" && "$has_orchestrator" -eq 1 ]]; then
      local _right_roles=()
      for _r in "${ROLES[@]}"; do
        if [[ "$_r" != "orchestrator" && "$_r" != "taskmanager" ]]; then _right_roles+=("$_r"); fi
      done
      local _n_right="${#_right_roles[@]}"
      local _first_right="${_right_roles[0]}"
      local _first_var="P_$(printf '%s' "$_first_right" | tr '[:lower:]' '[:upper:]')"
      # 1) 우측 상단 첫 pane (right from BASE)
      printf '+ %s=$(herdr pane split "$BASE" --direction right --cwd "%s" --no-focus | jq -r .result.pane.pane_id)\n' "$_first_var" "$CWD"
      # 2) PM 하단 orchestrator (down from BASE with ratio 0.5)
      if [[ "$NO_RESIZE" -eq 0 ]]; then
        printf '+ P_ORCHESTRATOR=$(herdr pane split "$BASE" --direction down --ratio 0.5 --cwd "%s" --no-focus | jq -r .result.pane.pane_id)\n' "$CWD"
      else
        printf '+ P_ORCHESTRATOR=$(herdr pane split "$BASE" --direction down --cwd "%s" --no-focus | jq -r .result.pane.pane_id)\n' "$CWD"
      fi
      # 3) 우측 나머지 pane들 (down from _first_var)
      _prev="$_first_var"
      _k=0
      local _idx
      for ((_idx=1; _idx<_n_right; _idx++)); do
        _role="${_right_roles[$_idx]}"
        _var="P_$(printf '%s' "$_role" | tr '[:lower:]' '[:upper:]')"
        if [[ "$NO_RESIZE" -eq 0 ]]; then
          _k=$((_k+1))
          _ratio="$(down_split_ratio "$_n_right" "$_k")"
          printf '+ %s=$(herdr pane split "$%s" --direction down --ratio %s --cwd "%s" --no-focus | jq -r .result.pane.pane_id)\n' "$_var" "$_prev" "$_ratio" "$CWD"
        else
          printf '+ %s=$(herdr pane split "$%s" --direction down --cwd "%s" --no-focus | jq -r .result.pane.pane_id)\n' "$_var" "$_prev" "$CWD"
        fi
        _prev="$_var"
      done
    else
      for _role in "${ROLES[@]}"; do
        _var="P_$(printf '%s' "$_role" | tr '[:lower:]' '[:upper:]')"
        if [[ "$_prev" == "BASE" ]]; then
          printf '+ %s=$(herdr pane split "$%s" --direction right --cwd "%s" --no-focus | jq -r .result.pane.pane_id)\n' "$_var" "$_prev" "$CWD"
        elif [[ "$NO_RESIZE" -eq 0 ]]; then
          # k번째 down 분할 ratio = 1/(N-k+1) (N=우측 컬럼 역할수): 정확 1:1:1:1 균등
          _k=$((_k+1))
          _ratio="$(down_split_ratio "${#ROLES[@]}" "$_k")"
          printf '+ %s=$(herdr pane split "$%s" --direction down --ratio %s --cwd "%s" --no-focus | jq -r .result.pane.pane_id)\n' "$_var" "$_prev" "$_ratio" "$CWD"
        else
          printf '+ %s=$(herdr pane split "$%s" --direction down --cwd "%s" --no-focus | jq -r .result.pane.pane_id)\n' "$_var" "$_prev" "$CWD"
        fi
        _prev="$_var"
      done
    fi
    printf '+ herdr pane rename "$BASE" "① PM"\n'
    _i=0
    for _role in "${ROLES[@]}"; do
      _var="P_$(printf '%s' "$_role" | tr '[:lower:]' '[:upper:]')"
      _agent="$(role_agent "$_role")"
      printf '+ herdr pane rename "$%s" "%s %s (%s)"\n' "$_var" "${NUMERALS[$_i]}" "$_role" "$_agent"
      _i=$((_i+1))
    done
    if [[ "$NO_START" -eq 0 ]]; then
      for _role in "${ROLES[@]}"; do
        _var="P_$(printf '%s' "$_role" | tr '[:lower:]' '[:upper:]')"
        _agent="$(role_agent "$_role")"
        if [[ "$KIND" == "opencode" ]]; then
          opencode_session_for "$_agent"
          _sid_var="SID_$(printf '%s' "$_role" | tr '[:lower:]' '[:upper:]')"
          printf '+ wait_pane_ready "$%s"\n' "$_var"
          printf '+ herdr agent list | grep -q %s || herdr agent start %s --kind %s --pane "$%s" -- --session "$%s"\n' "$_agent" "$_agent" "$KIND" "$_var" "$_sid_var"
        else
          printf '+ wait_pane_ready "$%s"\n' "$_var"
          printf '+ herdr agent list | grep -q %s || herdr agent start %s --kind %s --pane "$%s"\n' "$_agent" "$_agent" "$KIND" "$_var"
        fi
      done
    fi
    return
  fi

  need_cmd herdr
  need_cmd jq
  local base_pane=""
  base_pane="$(herdr pane current 2>/dev/null | herdr_pane_id || true)"
  if [[ -z "$base_pane" ]]; then
    # current 파싱 실패 시 HERDR_PANE_ID env로 fallback
    base_pane="${HERDR_PANE_ID:-}"
  fi

  if [[ -z "$base_pane" ]]; then
    echo "error: 현재 Pane ID를 확인할 수 없습니다. Herdr 세션 안에서 실행하세요." >&2
    exit 1
  fi
  log "BASE(PM) pane: $base_pane (preset=${PRESET}, layout=${LAYOUT})"
  local PANE_IDS=()
  if [[ "$LAYOUT" == "2col" && "$has_orchestrator" -eq 1 ]]; then
    local right_roles=() r
    for r in "${ROLES[@]}"; do
      if [[ "$r" != "orchestrator" && "$r" != "taskmanager" ]]; then right_roles+=("$r"); fi
    done
    local n_right="${#right_roles[@]}"
    local first_right_role="${right_roles[0]}"
    local split_out pane_id

    # 1) 우측 상단 첫 pane (PM에서 right 분할)
    split_out="$(herdr pane split "$base_pane" --direction right --cwd "$CWD" --no-focus)"
    local first_right_pane
    first_right_pane="$(printf '%s' "$split_out" | herdr_pane_id || true)"
    if [[ -z "$first_right_pane" ]]; then echo "error: ${first_right_role} 분할 결과에서 pane_id 파싱 실패: $split_out" >&2; exit 1; fi
    log "${first_right_role} pane: $first_right_pane"

    # 2) PM 하단 orchestrator (PM에서 down 분할, ratio 0.5로 상하 50:50 균등)
    if [[ "$NO_RESIZE" -eq 0 ]]; then
      split_out="$(herdr pane split "$base_pane" --direction down --ratio 0.5 --cwd "$CWD" --no-focus)"
    else
      split_out="$(herdr pane split "$base_pane" --direction down --cwd "$CWD" --no-focus)"
    fi
    local orch_pane
    orch_pane="$(printf '%s' "$split_out" | herdr_pane_id || true)"
    if [[ -z "$orch_pane" ]]; then echo "error: orchestrator 분할 결과에서 pane_id 파싱 실패: $split_out" >&2; exit 1; fi
    log "orchestrator pane: $orch_pane"

    # 3) 우측 나머지 pane들 (first_right_pane 하단으로 순차 down 분할)
    local right_panes=("$first_right_pane")
    local prev_pane="$first_right_pane" k=0 ratio role idx
    for ((idx=1; idx<n_right; idx++)); do
      role="${right_roles[$idx]}"
      if [[ "$NO_RESIZE" -eq 0 ]]; then
        k=$((k+1))
        ratio="$(down_split_ratio "$n_right" "$k")"
        split_out="$(herdr pane split "$prev_pane" --direction down --ratio "$ratio" --cwd "$CWD" --no-focus)"
      else
        split_out="$(herdr pane split "$prev_pane" --direction down --cwd "$CWD" --no-focus)"
      fi
      pane_id="$(printf '%s' "$split_out" | herdr_pane_id || true)"
      if [[ -z "$pane_id" ]]; then echo "error: ${role} 분할 결과에서 pane_id 파싱 실패: $split_out" >&2; exit 1; fi
      right_panes+=("$pane_id")
      prev_pane="$pane_id"
      log "${role} pane: $pane_id"
    done

    # 4) ROLES 순서대로 PANE_IDS 매핑
    local right_idx=0
    for role in "${ROLES[@]}"; do
      if [[ "$role" == "orchestrator" || "$role" == "taskmanager" ]]; then
        PANE_IDS+=("$orch_pane")
      else
        PANE_IDS+=("${right_panes[$right_idx]}")
        right_idx=$((right_idx+1))
      fi
    done
  else
    # right-stack: ROLES 순서대로 체이닝 분할 (첫 역할은 right, 이후는 down).
    local prev_pane="$base_pane" split_out pane_id role direction ratio first=1 k=0 n_roles
    n_roles="${#ROLES[@]}"
    for role in "${ROLES[@]}"; do
      if [[ "$first" -eq 1 ]]; then
        direction="right"; first=0
        split_out="$(herdr pane split "$prev_pane" --direction "$direction" --cwd "$CWD" --no-focus)"
      elif [[ "$NO_RESIZE" -eq 0 ]]; then
        k=$((k+1))
        ratio="$(down_split_ratio "$n_roles" "$k")"
        split_out="$(herdr pane split "$prev_pane" --direction down --ratio "$ratio" --cwd "$CWD" --no-focus)"
      else
        split_out="$(herdr pane split "$prev_pane" --direction down --cwd "$CWD" --no-focus)"
      fi
      pane_id="$(printf '%s' "$split_out" | herdr_pane_id || true)"
      if [[ -z "$pane_id" ]]; then echo "error: ${role} 분할 결과에서 pane_id 파싱 실패: $split_out" >&2; exit 1; fi
      PANE_IDS+=("$pane_id")
      prev_pane="$pane_id"
      log "${role} pane: $pane_id"
    done
  fi

  run herdr pane rename "$base_pane" "① PM"
  local i=0 agent cap
  for role in "${ROLES[@]}"; do
    agent="$(role_agent "$role")"
    cap="$(printf '%s' "$role" | sed -e 's/^./\U&/')"
    run herdr pane rename "${PANE_IDS[$i]}" "${NUMERALS[$i]} ${cap} (${agent})"
    i=$((i+1))
  done

  if [[ "$NO_START" -eq 0 ]]; then
    if [[ "$KIND" == "opencode" ]]; then need_cmd opencode; fi
    local sid=""
    i=0
    for role in "${ROLES[@]}"; do
      agent="$(role_agent "$role")"
      if ! herdr agent list 2>/dev/null | grep -q -- "$agent"; then
        # shell 미준비 race(agent_pane_busy) 방지: start 직전에 pane ready 이벤트 확정.
        wait_pane_ready "${PANE_IDS[$i]}" || { echo "error: ${agent} 시작 중단 (pane ${PANE_IDS[$i]} shell 미준비)" >&2; exit 1; }
        if [[ "$KIND" == "opencode" ]]; then
          if ! sid="$(opencode_session_for "$agent")"; then
            echo "error: ${agent} 세션 생성 실패 → 시작 중단 (이미 생성된 pane: ${#PANE_IDS[@]}개)" >&2
            exit 1
          fi
          run herdr agent start "$agent" --kind "$KIND" --pane "${PANE_IDS[$i]}" -- --session "$sid"
        else
          run herdr agent start "$agent" --kind "$KIND" --pane "${PANE_IDS[$i]}"
        fi
      else log "$agent 이미 존재 → 시작 생략"; fi
      i=$((i+1))
    done
  fi
  local done_list=""
  for role in "${ROLES[@]}"; do done_list+="$(role_agent "$role") / "; done
  done_list="${done_list% / }"
  log "완료: prefix=${PREFIX} preset=${PRESET} (${done_list})"
}

# --- 자동 herdr 사전 점검 (실제 쓰기 전 fail-fast; dry-run/templates-only 면제) ---
if [[ "$DRY_RUN" -eq 0 && "$TEMPLATES_ONLY" -eq 0 ]]; then
  precheck_herdr || exit $?
fi

printf 'herdr-team v%s\n' "$VERSION"
PREV_ACTIVE="$(active_preset)"
if [[ "$NO_TEMPLATE" -eq 0 ]]; then guard_preconditions || exit $?; fi
setup_templates
setup_opencode_agents
setup_permissions
if [[ "$TEMPLATES_ONLY" -eq 1 ]]; then
  if [[ "$WATCHER" -eq 1 ]]; then start_watcher; fi
  log "templates-only: 템플릿 설치 완료 (pane 분할 생략)"
  exit 0
fi
setup_panes
if [[ "$WATCHER" -eq 1 ]]; then start_watcher; fi
